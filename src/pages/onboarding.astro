---
/**
 * Aufnahmebogen Meisterseite — wird GEMEINSAM mit dem Kunden ausgefüllt,
 * per Bildschirmübertragung im Onboarding-Termin (Ben, 21.08.2026).
 *
 * Ersetzt das alte KI-PA-Onboarding (Mailbox, Calendly, Arbeitskanal) — das
 * fragte Zugänge für ein Produkt ab, das seit 28.07. nicht mehr verkauft wird.
 * Archiv + Begründung: `_archive/2026-08-21-onboarding-ki-pa/`.
 *
 * ZWEI WEGE aus dem Formular heraus, beide gebaut:
 *   - Zwischenspeichern im Browser (überlebt Neuladen und Verbindungsabbruch —
 *     bei einem 30-Minuten-Gespräch der wichtigere Teil)
 *   - Absenden an `pa.k-aizen.de/api/onboarding` (Mail + Discord) ODER drucken
 *
 * Inhaltlich deckungsgleich mit dem gedruckten Bogen
 * `00-blueprints/formulare/meisterseite-aufnahmebogen.html` — dort steht die
 * Langfassung mit allen Erläuterungen für den Verkäufer.
 *
 * noindex: Das ist kein Verkaufsdokument. Es zeigt Interna (K.-o.-Kriterien,
 * Rechtsrahmen) und gehört nicht in die Suche.
 */
import KaizenLayout from '../layouts/KaizenLayout.astro';
---
<KaizenLayout
  title="Aufnahmebogen Meisterseite · k-AIzen"
  description="Aufnahmebogen für neue Meisterseite-Kunden — wird gemeinsam im Onboarding-Termin ausgefüllt."
  path="/onboarding"
  activeNav="home"
  noindex={true}
>
  <article class="kz-page" style="max-width: 780px;">
    <h1 class="kz-h1">
      Aufnahmebogen<br/>
      für Ihre Meisterseite.
    </h1>

    <p class="kz-lead">
      Wir gehen das gemeinsam durch — Sie müssen nichts vorbereiten. Etwa 30 Minuten.
      Alles, was hier steht, brauchen wir, um Ihre Seite zu bauen und sie danach
      am Laufen zu halten.
    </p>

    <div class="kz-help-card">
      <strong>Wenn Sie bei einem Punkt unsicher sind, lassen Sie ihn offen.</strong>
      Wir tragen ihn später nach. Eine Lücke ist besser als eine Angabe, die nicht stimmt —
      besonders beim Impressum, das rechtlich exakt sein muss.
      <br><br>
      Ihre Eingaben bleiben in diesem Browser gespeichert, bis Sie „Formular leeren“ drücken — auch nach
      dem Absenden. Sie können die Seite zwischendurch neu laden, ohne etwas zu verlieren
      (<a href="/datenschutz/">Datenschutzerklärung</a>, Ziffer 7).
    </div>

    <form id="aufnahme-form" novalidate>

      <!-- ── Der Betrieb ─────────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Der Betrieb</h2>
        </div>
        <p class="kz-section-intro">
          Diese Angaben kommen ins Impressum und müssen rechtlich stimmen — am besten
          vom Briefkopf oder Handelsregisterauszug abschreiben, nicht aus dem Kopf.
        </p>

        <div class="kz-row-2">
          <div class="kz-field">
            <label for="full_name">Inhaber / Geschäftsführer <span class="req">*</span></label>
            <input id="full_name" name="full_name" type="text" required placeholder="z. B. Michael Brandner" />
          </div>
          <div class="kz-field">
            <label for="firma">Firmenname mit Rechtsform</label>
            <input id="firma" name="firma" type="text" placeholder="z. B. Brandner Bedachungen GmbH" />
            <span class="kz-hint">Genau wie im Handelsregister.</span>
          </div>
        </div>

        <div class="kz-field">
          <label for="anschrift">Anschrift</label>
          <input id="anschrift" name="anschrift" type="text" placeholder="Straße, Hausnummer, PLZ, Ort" />
        </div>

        <div class="kz-row-2">
          <div class="kz-field">
            <label for="contact_email">E-Mail (geschäftlich) <span class="req">*</span></label>
            <input id="contact_email" name="contact_email" type="email" required placeholder="info@beispiel.de" />
          </div>
          <div class="kz-field">
            <label for="telefon">Telefon</label>
            <input id="telefon" name="telefon" type="tel" placeholder="0911 …" />
          </div>
        </div>

        <div class="kz-row-2">
          <div class="kz-field">
            <label for="hrb">Handelsregister-Nr. + Amtsgericht</label>
            <input id="hrb" name="hrb" type="text" placeholder="nur bei GmbH/UG/OHG/KG" />
          </div>
          <div class="kz-field">
            <label for="ustid">Umsatzsteuer-ID</label>
            <input id="ustid" name="ustid" type="text" placeholder="DE… — falls vorhanden" />
          </div>
        </div>

        <div class="kz-field">
          <label for="gewerk">Gewerk und Leistungen</label>
          <textarea id="gewerk" name="gewerk" rows="3" placeholder="z. B. Dachdeckerei — Dachreparatur, Neueindeckung, Flachdach, Dachfenster, Dachrinnen"></textarea>
          <span class="kz-hint">Diese Liste wird zu den Leistungen auf der Seite und im Schema für Suchmaschinen.</span>
        </div>

        <div class="kz-field">
          <label for="einsatzgebiet">Einsatzgebiet</label>
          <input id="einsatzgebiet" name="einsatzgebiet" type="text" placeholder="z. B. Nürnberg, Fürth, Erlangen, Schwabach" />
          <span class="kz-hint">Orte, in denen Sie tatsächlich arbeiten — sie steuern, wo Sie gefunden werden.</span>
        </div>
      </section>

      <!-- ── Wie Sie arbeiten ────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Wie Sie arbeiten</h2>
        </div>
        <p class="kz-section-intro">
          Damit die Assistentin sich an Ihren Alltag anpasst und nicht umgekehrt.
        </p>

        <div class="kz-field">
          <label for="meldeweg">Wie erfahren Sie, dass ein Auftrag fertig ist?</label>
          <textarea id="meldeweg" name="meldeweg" rows="2" placeholder="Zuruf, WhatsApp-Gruppe, Zettel, Handwerkersoftware …"></textarea>
          <span class="kz-hint">Wir docken an Ihren bestehenden Weg an, statt einen neuen daneben zu stellen.</span>
        </div>

        <div class="kz-row-2">
          <div class="kz-field">
            <label for="wer_meldet">Wer meldet fertige Aufträge?</label>
            <input id="wer_meldet" name="wer_meldet" type="text" placeholder="z. B. Chef + 3 Monteure" />
            <span class="kz-hint">Nur der Chef reicht selten — er ist der Beschäftigtste.</span>
          </div>
          <div class="kz-field">
            <label for="volumen">Wie viele Aufträge pro Woche?</label>
            <input id="volumen" name="volumen" type="text" placeholder="ungefähr" />
            <span class="kz-hint">Grobe Zahl genügt.</span>
          </div>
        </div>

        <div class="kz-field">
          <label>Womit planen Sie Termine?</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="kalender" value="google" /> Google Kalender</label>
            <label><input type="radio" name="kalender" value="outlook" /> Outlook / Microsoft</label>
            <label><input type="radio" name="kalender" value="apple" /> Apple / iCloud</label>
            <label><input type="radio" name="kalender" value="papier" /> Papier oder Whiteboard</label>
            <label><input type="radio" name="kalender" value="keins" /> gar nichts Festes</label>
          </div>
        </div>

        <div class="kz-field">
          <label>Handys der Mitarbeiter</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="handys" value="dienst" /> Diensthandys</label>
            <label><input type="radio" name="handys" value="privat" /> private Geräte</label>
            <label><input type="radio" name="handys" value="gemischt" /> gemischt</label>
          </div>
          <span class="kz-hint">Bei privaten Geräten brauchen wir die Zustimmung der Mitarbeiter.</span>
        </div>
      </section>

      <!-- ── Ihre Kunden ─────────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Ihre Kunden</h2>
        </div>
        <p class="kz-section-intro">
          Nach einem Auftrag bitten wir Ihre Kunden in Ihrem Namen um eine Bewertung.
          Dafür brauchen wir einen Weg, sie zu erreichen — und Ihre ausdrückliche Erlaubnis.
        </p>

        <div class="kz-field">
          <label for="kontaktquelle">Wo stehen die Kontaktdaten Ihrer Kunden heute?</label>
          <textarea id="kontaktquelle" name="kontaktquelle" rows="2" placeholder="Programm, Ordner, Handy, Kopf …"></textarea>
        </div>

        <div class="kz-field">
          <label>Eher E-Mail oder Telefon?</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="kontaktart" value="mail" /> meist E-Mail</label>
            <label><input type="radio" name="kontaktart" value="tel" /> meist Telefon</label>
            <label><input type="radio" name="kontaktart" value="beides" /> beides</label>
          </div>
        </div>

        <div class="kz-field">
          <label for="bewertung_ist">Fragen Sie heute schon nach Bewertungen? Wie?</label>
          <textarea id="bewertung_ist" name="bewertung_ist" rows="2"></textarea>
          <span class="kz-hint">
            Ehrliche Antwort ist wichtiger als eine schöne. Rabatte für gute Bewertungen oder
            nur zufriedene Kunden zu fragen ist rechtlich heikel — unser System fragt jeden
            Kunden dieselbe Frage über denselben Link und hält Sie damit aus der Sache raus.
          </span>
        </div>

        <div class="kz-field">
          <label>Dürfen wir Ihre Kunden in Ihrem Namen anschreiben?</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="erlaubnis" value="ja" /> ja</label>
            <label><input type="radio" name="erlaubnis" value="offen" /> noch klären</label>
          </div>
          <span class="kz-hint">
            Wir schreiben nur Menschen an, deren Daten Sie im Rahmen eines Auftrags erhalten haben,
            und jede Nachricht enthält einen Widerspruchshinweis. Das ist gesetzlich vorgeschrieben
            und schützt Sie.
          </span>
        </div>
      </section>

      <!-- ── Google ──────────────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Ihr Google-Eintrag</h2>
        </div>
        <p class="kz-section-intro">
          Das ist der Eintrag bei Google Maps mit Öffnungszeiten, Fotos und Bewertungen.
          Er entscheidet mehr über neue Anfragen als die Website — deshalb pflegen wir ihn mit.
        </p>

        <div class="kz-field">
          <label for="gmb_zugang">Wer kann sich dort einloggen?</label>
          <textarea id="gmb_zugang" name="gmb_zugang" rows="2" placeholder="ich selbst / eine Agentur / weiß ich nicht / kein Eintrag vorhanden"></textarea>
          <span class="kz-hint">
            Oft hat den Zugang noch jemand von früher — der Neffe, eine alte Agentur. Falls unklar:
            kein Problem, wir finden es gemeinsam heraus. Es dauert nur länger, deshalb fragen wir früh.
          </span>
        </div>

        <div class="kz-field">
          <label>Zugriff für uns</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="gmb_weg" value="einladung" /> Sie laden uns als Manager ein</label>
            <label><input type="radio" name="gmb_weg" value="gemeinsam" /> wir gehen es zusammen durch</label>
            <label><input type="radio" name="gmb_weg" value="wiederherstellung" /> Zugang muss erst wiederhergestellt werden</label>
          </div>
          <span class="kz-hint">
            Als <strong>Manager</strong> dürfen wir das Profil pflegen und auf Bewertungen antworten —
            aber nichts löschen, den Inhaber nicht wechseln und keine anderen Nutzer entfernen.
            Sie können uns jederzeit mit einem Klick wieder entfernen.
          </span>
        </div>

        <div class="kz-field">
          <label>Wer antwortet auf kritische Bewertungen?</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="bewertung_antwort" value="freigabe" /> gute automatisch, kritische erst nach meiner Freigabe</label>
            <label><input type="radio" name="bewertung_antwort" value="alle_auto" /> alle automatisch</label>
            <label><input type="radio" name="bewertung_antwort" value="alle_freigabe" /> immer erst freigeben</label>
          </div>
          <span class="kz-hint">Unsere Empfehlung ist die erste Zeile — eine automatische Antwort unter einer echten Beschwerde steht öffentlich unter Ihrem Namen.</span>
        </div>
      </section>

      <!-- ── Bilder und Texte ────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Bilder und Texte</h2>
        </div>
        <p class="kz-section-intro">
          Ihre eigenen Fotos wirken stärker als jedes gekaufte Bild — Handyfotos genügen völlig.
        </p>

        <div class="kz-field">
          <label>Dürfen Fotos Ihrer Baustellen öffentlich erscheinen?</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="fotos" value="ja" /> ja</label>
            <label><input type="radio" name="fotos" value="rueckfrage" /> nur nach Rücksprache</label>
          </div>
          <span class="kz-hint">Bei fremdem Eigentum oder erkennbaren Personen brauchen wir ggf. deren Einverständnis.</span>
        </div>

        <div class="kz-field">
          <label>Texte zu Ihren Arbeiten</label>
          <div class="kz-radio-grid">
            <label><input type="radio" name="texte" value="auto" /> dürfen von allein erscheinen</label>
            <label><input type="radio" name="texte" value="freigabe" /> möchte ich vorher sehen</label>
          </div>
          <span class="kz-hint">Die Texte entstehen aus Ihren eigenen Notizen und werden nur in ganze Sätze gebracht — erfunden wird nichts. Kundennamen erscheinen nie.</span>
        </div>

        <div class="kz-field">
          <label for="tabu">Gibt es Arbeiten, die NICHT auf die Website sollen?</label>
          <textarea id="tabu" name="tabu" rows="2"></textarea>
        </div>

        <div class="kz-field">
          <label for="material">Was haben Sie bereits an Material?</label>
          <textarea id="material" name="material" rows="2" placeholder="Logo, Fotos, alte Website, Flyer …"></textarea>
        </div>
      </section>

      <!-- ── Technisches ─────────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Technisches</h2>
        </div>

        <div class="kz-row-2">
          <div class="kz-field">
            <label for="domain">Wunsch-Adresse im Internet</label>
            <input id="domain" name="domain" type="text" placeholder="z. B. brandner-bedachungen.de" />
            <span class="kz-hint">Falls schon vorhanden: Wer verwaltet sie?</span>
          </div>
          <div class="kz-field">
            <label for="anfragen_an">Wohin sollen Anfragen gehen?</label>
            <input id="anfragen_an" name="anfragen_an" type="text" placeholder="Handynummer und / oder E-Mail" />
          </div>
        </div>

        <div class="kz-row-2">
          <div class="kz-field">
            <label for="lena_mail">E-Mail für Rückfragen der Assistentin</label>
            <input id="lena_mail" name="lena_mail" type="email" placeholder="wer liest sie?" />
          </div>
          <div class="kz-field">
            <label for="technik_kontakt">Wer hilft, wenn technisch etwas klemmt?</label>
            <input id="technik_kontakt" name="technik_kontakt" type="text" placeholder="Name, Erreichbarkeit" />
          </div>
        </div>

        <div class="kz-field">
          <label for="altvertraege">Bestehende Verträge, die stören könnten?</label>
          <textarea id="altvertraege" name="altvertraege" rows="2" placeholder="Website-Vertrag, Domain bei einer Agentur, Hosting-Abo …"></textarea>
          <span class="kz-hint">Vor dem Start klären, sonst gibt es doppelte Kosten oder blockierte Adressen.</span>
        </div>
      </section>

      <!-- ── Erwartung ───────────────────────────────────────────────── -->
      <section class="kz-form-section">
        <div class="kz-section-head">
          <h2 class="kz-h2">Was Sie erwarten</h2>
        </div>

        <div class="kz-field">
          <label for="erwartung">Was erhoffen Sie sich in den ersten drei Monaten?</label>
          <textarea id="erwartung" name="erwartung" rows="3"></textarea>
          <span class="kz-hint">
            Damit wir es gerade rücken, falls nötig: Wir liefern Sichtbarkeit, frische Bewertungen
            und ein vollständiges Profil. <strong>Wie viele Aufträge daraus werden, hängt an Ihrem
            Markt und Ihrem Angebot</strong> — das versprechen wir nicht.
          </span>
        </div>

        <div class="kz-field">
          <label for="notizen">Sonstiges</label>
          <textarea id="notizen" name="notizen" rows="3" placeholder="Alles, was uns sonst helfen könnte."></textarea>
        </div>

        <div class="kz-field">
          <label class="kz-checkbox">
            <input type="checkbox" id="consent" name="consent" required />
            <span>
              Ich bin damit einverstanden, dass k-AIzen diese Angaben zur Vorbereitung
              meines Setups verarbeitet. <span class="req">*</span>
            </span>
          </label>
        </div>

        <div class="kz-actions">
          <button type="submit" class="kz-btn-submit" id="btn-senden">Formular absenden</button>
          <button type="button" class="kz-btn-second" id="btn-drucken">Drucken / als PDF sichern</button>
          <button type="button" class="kz-btn-second" id="btn-leeren">Formular leeren</button>
        </div>
        <p class="kz-mini-note" id="speicher-status">Eingaben werden in diesem Browser zwischengespeichert.</p>

        <div id="status" hidden></div>
      </section>
    </form>
  </article>

  <script is:inline>
    (function () {
      const form = document.getElementById('aufnahme-form');
      const status = document.getElementById('status');
      const btnSenden = document.getElementById('btn-senden');
      const speicherStatus = document.getElementById('speicher-status');
      const SCHLUESSEL = 'kaizen-aufnahmebogen';

      /* ── Zwischenspeichern ─────────────────────────────────────────
         Wichtiger als das Absenden: Ein 30-Minuten-Gespräch überlebt kein
         versehentliches Neuladen. Gespeichert wird bei jeder Eingabe. */
      const felder = () => form.querySelectorAll('input, textarea, select');

      function speichern() {
        const daten = {};
        felder().forEach((f) => {
          if (!f.name) return;
          if (f.type === 'checkbox') daten[f.name] = f.checked;
          else if (f.type === 'radio') { if (f.checked) daten[f.name] = f.value; }
          else daten[f.name] = f.value;
        });
        try {
          localStorage.setItem(SCHLUESSEL, JSON.stringify(daten));
          const zeit = new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
          speicherStatus.textContent = `Zwischengespeichert um ${zeit}.`;
        } catch (e) {
          speicherStatus.textContent = 'Konnte nicht zwischenspeichern — bitte nicht neu laden.';
        }
      }

      function laden() {
        let daten;
        try { daten = JSON.parse(localStorage.getItem(SCHLUESSEL) || '{}'); } catch { return; }
        if (!Object.keys(daten).length) return;
        felder().forEach((f) => {
          if (!f.name || !(f.name in daten)) return;
          if (f.type === 'checkbox') f.checked = !!daten[f.name];
          else if (f.type === 'radio') f.checked = f.value === daten[f.name];
          else f.value = daten[f.name];
        });
        speicherStatus.textContent = 'Zuletzt gespeicherter Stand geladen.';
      }

      laden();
      form.addEventListener('input', speichern);
      form.addEventListener('change', speichern);

      document.getElementById('btn-drucken').addEventListener('click', () => window.print());

      document.getElementById('btn-leeren').addEventListener('click', () => {
        if (!confirm('Alle Eingaben löschen?')) return;
        localStorage.removeItem(SCHLUESSEL);
        form.reset();
        speicherStatus.textContent = 'Formular geleert.';
      });

      /* ── Absenden ──────────────────────────────────────────────────
         Der Endpunkt verlangt full_name, contact_email und consent
         (geprüft 21.08.: er antwortet mit 400, wenn eines fehlt). */
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        status.hidden = true;

        const fehlend = [];
        if (!form.full_name.value.trim()) fehlend.push('Inhaber / Geschäftsführer');
        if (!form.contact_email.value.trim()) fehlend.push('E-Mail');
        if (!form.consent.checked) fehlend.push('Einverständnis');
        if (fehlend.length) {
          status.className = 'error';
          status.innerHTML = `<strong>Es fehlt noch:</strong> ${fehlend.join(', ')}.`;
          status.hidden = false;
          status.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        btnSenden.disabled = true;
        btnSenden.textContent = 'Wird gesendet …';

        const daten = Object.fromEntries(new FormData(form).entries());
        daten.consent = form.consent.checked;
        daten._formular = 'meisterseite-aufnahmebogen';
        daten._submitted_at = new Date().toISOString();

        try {
          const basis = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
            ? 'http://localhost:4124'
            : 'https://pa.k-aizen.de';
          const res = await fetch(`${basis}/api/onboarding`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(daten),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          status.className = 'success';
          status.innerHTML = '<strong>Angekommen.</strong> Wir melden uns mit den nächsten Schritten.';
          status.hidden = false;
          // Zwischenspeicher NICHT löschen: Falls beim Absenden etwas schiefging,
          // das niemand bemerkt hat, sind die Eingaben noch da.
          btnSenden.textContent = 'Gesendet';
          status.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          status.className = 'error';
          status.innerHTML = `<strong>Hat nicht geklappt:</strong> ${err.message}.
            Die Eingaben sind gespeichert und gehen nicht verloren —
            am einfachsten jetzt auf „Drucken / als PDF sichern" und uns das schicken.`;
          status.hidden = false;
          btnSenden.disabled = false;
          btnSenden.textContent = 'Nochmal versuchen';
          status.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    })();
  </script>
  <style>
    .kz-help-card {
      background: var(--kz-cream-deep);
      color: var(--fg-inverse);
      border: 1px solid rgba(255, 143, 94, 0.24); /* volle Hairline statt dicker Farbkante */
      padding: 16px 20px;
      border-radius: 6px;
      margin: 24px 0 40px;
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.6;
    }

    .kz-form-section {
      margin-top: 56px;
      padding-top: 32px;
      border-top: 1px solid var(--kz-border);
    }
    .kz-form-section:first-of-type { border-top: none; padding-top: 0; }

    .kz-section-head {
      display: flex; align-items: baseline; gap: 16px; margin-bottom: 8px;
    }
    .kz-section-num {
      font-family: var(--font-mono);
      font-size: 14px;
      letter-spacing: 0.18em;
      color: var(--kz-ember-text);
      font-weight: 600;
    }
    .kz-section-head h2 {
      font-family: var(--font-display);
      font-size: clamp(22px, 2.6vw, 30px);
      font-weight: 500;
      margin: 0;
      line-height: 1.15;
    }
    .kz-section-intro {
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.55;
      color: var(--fg-muted);
      margin: 0 0 28px;
      max-width: 580px;
    }

    .kz-field { margin-bottom: 20px; }
    .kz-field label {
      display: block;
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: var(--fg);
      margin-bottom: 6px;
    }
    .kz-field input[type="text"],
    .kz-field input[type="email"],
    .kz-field input[type="tel"],
    .kz-field input[type="url"],
    .kz-field input[type="number"],
    .kz-field input[type="password"],
    .kz-field select,
    .kz-field textarea {
      width: 100%;
      padding: 11px 14px;
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.4;
      border: 1px solid var(--kz-border);
      border-radius: 6px;
      /* Dunkle, leicht vertiefte Felder statt weißer Löcher im Charcoal */
      background: var(--kz-charcoal);
      color: var(--fg);
      transition: border-color 160ms;
    }
    .kz-field input:focus,
    .kz-field select:focus,
    .kz-field textarea:focus {
      outline: none;
      border-color: var(--kz-ember);
      box-shadow: 0 0 0 3px rgba(232, 90, 43, 0.22);
    }
    .kz-field textarea { resize: vertical; min-height: 80px; }
    .kz-hint {
      display: block;
      font-family: var(--font-sans);
      font-size: 12px;
      color: var(--fg-muted);
      margin-top: 4px;
      line-height: 1.45;
    }

    .req { color: var(--kz-ember-text); font-weight: 700; }

    .kz-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 600px) {
      .kz-row-2 { grid-template-columns: 1fr; }
    }

    .kz-radio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 10px;
      margin-top: 4px;
    }
    .kz-radio-grid label {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 14px;
      border: 1px solid var(--kz-border);
      border-radius: 6px;
      cursor: pointer;
      font-weight: 400;
      background: var(--kz-cream-deep);
      color: var(--fg-inverse);
      transition: border-color 140ms, background 140ms;
    }
    .kz-radio-grid label:hover {
      border-color: var(--kz-ember);
      background: rgba(232, 90, 43, 0.10);
    }
    .kz-radio-grid input[type="radio"] {
      accent-color: var(--kz-ember);
    }

    .kz-explain {
      background: var(--kz-cream-paper, var(--kz-cream-deep));
      color: var(--fg-inverse);
      padding: 0 18px;
      border-radius: 6px;
      margin: 16px 0 20px;
      font-family: var(--font-sans);
    }
    .kz-explain summary {
      cursor: pointer;
      padding: 14px 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--kz-ember-text);
    }
    .kz-explain[open] summary {
      border-bottom: 1px solid var(--kz-border);
      margin-bottom: 12px;
    }
    .kz-explain ol, .kz-explain ul, .kz-explain p {
      font-size: 14px;
      line-height: 1.6;
      padding-left: 20px;
      padding-bottom: 12px;
    }
    .kz-explain p { padding-left: 0; }
    .kz-explain code {
      background: var(--kz-charcoal);
      color: var(--fg);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 13px;
      border: 1px solid var(--kz-border);
    }
    .kz-explain a { color: var(--kz-ember-text); }

    .kz-howto {
      background: rgba(232, 90, 43, 0.08);
      color: var(--fg);
      border: 1px solid rgba(255, 143, 94, 0.24); /* volle Hairline statt dicker Farbkante */
      padding: 16px 20px;
      border-radius: 6px;
      margin: 12px 0 24px;
      font-family: var(--font-sans);
    }
    .kz-howto h4 {
      font-family: var(--font-display);
      font-size: 18px;
      margin: 0 0 12px;
      font-weight: 600;
    }
    .kz-howto ol { padding-left: 20px; font-size: 14px; line-height: 1.6; margin: 0; }
    .kz-howto code,
    .kz-explain code {
      background: var(--kz-charcoal);
      color: var(--fg);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 13px;
      border: 1px solid var(--kz-border);
      cursor: copy;
      transition: background 120ms, border-color 120ms;
      user-select: all;
    }
    .kz-howto code:hover,
    .kz-explain code:hover {
      background: var(--kz-cream-deep);
      border-color: var(--kz-ember);
    }
    /* Kopiert-Zustand: Grün für Dunkel aufgehellt (gemessen 11:1),
       das Emoji-Icon ist beim Dark-Umbau entfallen (craft-floor). */
    .kz-howto code.kz-copied,
    .kz-explain code.kz-copied {
      background: rgba(74, 222, 128, 0.14);
      border-color: #4CBB72;
    }
    .kz-howto code.kz-copied::after,
    .kz-explain code.kz-copied::after {
      content: "✓";
      margin-left: 6px;
      font-size: 10px;
      color: #86D9A0;
      opacity: 1;
    }
    .kz-howto a { color: var(--kz-ember-text); font-weight: 500; }
    .kz-mini-note {
      font-size: 13px;
      color: var(--fg-muted);
      margin-top: 12px;
      font-style: italic;
    }

    .kz-consent {
      background: var(--kz-cream-deep);
      color: var(--fg-inverse);
      padding: 18px 20px;
      border-radius: 6px;
      border: 1px solid var(--kz-border);
    }
    /* Override .kz-field label cream-color when inside consent box */
    .kz-consent label,
    .kz-consent span {
      color: var(--fg-inverse);
    }
    .kz-checkbox {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.5;
      color: inherit;
    }
    .kz-checkbox input { margin-top: 4px; accent-color: var(--kz-ember); }
    .kz-checkbox a { color: var(--kz-ember-text); text-decoration: underline; }

    .kz-btn-submit {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 32px;
      padding: 16px 32px;
      /* Auf Charcoal wäre ein Charcoal-Button unsichtbar — der
         Abschluss-Knopf trägt jetzt die Glut wie alle Primär-CTAs. */
      background: linear-gradient(135deg, var(--kz-ember), #FF7A45);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-family: var(--font-sans);
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: all 200ms;
    }
    .kz-btn-submit:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 26px -6px rgba(232, 90, 43, 0.55);
    }
    .kz-btn-submit:disabled {
      opacity: 0.6;
      cursor: wait;
      transform: none;
      box-shadow: none;
    }

    #submit-status {
      margin-top: 20px;
      padding: 14px 18px;
      border-radius: 6px;
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.5;
    }
    /* Statusbänder: volle Hairline statt dicker Farbkante; Grün und
       Ember für Dunkel aufgehellt (gemessen ≥10:1). */
    #submit-status.success {
      background: rgba(74, 222, 128, 0.10);
      border: 1px solid rgba(134, 217, 160, 0.4);
      color: #86D9A0;
    }
    #submit-status.error {
      background: rgba(232, 90, 43, 0.12);
      border: 1px solid rgba(255, 143, 94, 0.4);
      color: var(--kz-ember-text);
    }

    /* Neu für den Aufnahmebogen: Knopfleiste und zweitrangige Knöpfe.
       Der alte Bogen hatte nur einen Absende-Knopf. */
    .kz-actions {
      display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
      margin-top: 28px;
    }
    .kz-btn-second {
      padding: 12px 20px;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 500;
      color: var(--fg);
      background: transparent;
      border: 1px solid var(--kz-border);
      border-radius: 6px;
      cursor: pointer;
      transition: border-color .18s ease, color .18s ease;
    }
    .kz-btn-second:hover { border-color: var(--kz-ember-text); color: var(--kz-ember-text); }

    /* Druckfassung: Der Bogen wird im Termin auch ausgedruckt oder als PDF
       gesichert — dann stören Navigation und Knöpfe. */
    @media print {
      .kz-actions, .kz-mini-note, header, footer, nav { display: none !important; }
      .kz-page { max-width: none; }
      .kz-form-section { break-inside: avoid; border-top: 1px solid #999; }
      .kz-section-head h2 { break-after: avoid; }
      .kz-field input, .kz-field textarea, .kz-field select {
        border: none; border-bottom: 1px solid #666; border-radius: 0;
        background: none; padding: 3px 2px;
      }
      .kz-field textarea { border: 1px solid #999; }
      .kz-help-card { background: none; border: 1px solid #999; color: inherit; }
    }
  </style>
</KaizenLayout>
