    .kz-offer__main, .kz-offer__side { border-radius:var(--radius-lg); border:1px solid var(--line-soft); background:var(--card); box-shadow:var(--shadow-md); }
    .kz-offer__main { padding:clamp(28px,4vw,44px); }
