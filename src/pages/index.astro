    .kz-offer__main p, .kz-offer__side p { color:var(--slate); margin-top:16px; font-size:1.02rem; line-height:1.65; }
    .kz-checklist { list-style:none; display:grid; gap:12px; margin-top:24px; }
    .kz-checklist li { position:relative; padding-left:30px; color:var(--ink-soft); line-height:1.55; }
    .kz-checklist li::before { content:'✓'; position:absolute; left:0; top:1px; display:grid; place-items:center; width:20px; height:20px; border-radius:50%; background:var(--indigo-wash); color:var(--indigo-deep); font-weight:800; font-size:12px; }
    .kz-offer__side { padding:28px; display:flex; flex-direction:column; justify-content:center; background:linear-gradient(145deg,var(--card),rgba(232,90,43,0.14)); }
    .kz-offer__side .kz-btn { justify-content:center; margin-top:24px; width:100%; }
