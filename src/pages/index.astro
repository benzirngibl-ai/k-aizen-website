    .kz-fit-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin-top:42px; }
    .kz-fit-card { min-height:360px; padding:clamp(26px,4vw,38px); border-radius:var(--radius-lg); background:linear-gradient(145deg,var(--card),rgba(232,90,43,0.12)); border:1px solid var(--line-soft); box-shadow:var(--shadow-md); }
    .kz-fit-card--quiet { background:var(--card); }
    .kz-fit-card__k, .kz-decision-card__k { font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--indigo-deep); font-weight:800; }
    .kz-fit-card h3, .kz-decision-card h3 { margin-top:14px; font-size:clamp(1.25rem,2.2vw,1.65rem); letter-spacing:-0.02em; line-height:1.15; }
    .kz-fit-card ul { list-style:none; display:grid; gap:14px; margin:24px 0 0; padding:0; }
    .kz-fit-card li { position:relative; padding-left:30px; color:var(--ink-soft); line-height:1.58; }
    .kz-fit-card li::before { content:'✓'; position:absolute; left:0; top:1px; display:grid; place-items:center; width:20px; height:20px; border-radius:50%; background:rgba(232,90,43,0.18); color:var(--indigo-deep); font-weight:800; font-size:12px; }
    .kz-fit-card--quiet li::before { content:'•'; background:rgba(255,240,225,0.08); color:var(--slate); }
    .kz-decision-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin-top:44px; }
    .kz-decision-card { min-height:245px; padding:24px; border-radius:var(--radius-lg); background:var(--card); border:1px solid var(--line-soft); box-shadow:var(--shadow-sm); }
