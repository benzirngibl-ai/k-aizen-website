    .kz-duo-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(24px,5vw,80px); align-items:center; }
    .kz-process { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin-top:48px; counter-reset:process; }
    .kz-process__step { position:relative; min-height:250px; padding:26px; border-radius:var(--radius-lg); background:var(--card); border:1px solid var(--line-soft); box-shadow:var(--shadow-sm); overflow:hidden; }
    .kz-process__step::after { content:''; position:absolute; left:26px; right:26px; bottom:0; height:2px; background:linear-gradient(90deg,var(--indigo),var(--violet)); opacity:0.85; box-shadow:0 0 12px rgba(255,122,69,0.5); }
    .kz-process__step h3 { font-size:1.2rem; margin-top:18px; margin-bottom:10px; letter-spacing:-0.015em; }
    .kz-process__step p { color:var(--slate); font-size:0.95rem; line-height:1.6; }
    .kz-split-card { background:var(--card); border:1px solid var(--line-soft); border-radius:var(--radius-xl); padding:36px; box-shadow:var(--shadow-md); transition:transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out); will-change:transform; }
    .kz-split-card:hover { box-shadow:var(--shadow-lg); }
    /* Tieferes Ember-Duo statt indigo→violet: heller Fließtext erreicht
       sonst keine 4.5:1 auf der Glut (gemessen: 2.8:1 → jetzt ≥5:1). */
    .kz-split-card--accent { background:linear-gradient(145deg,#9E3610,#C2491F); color:#fff; border:none; box-shadow:var(--shadow-md), 0 0 70px -14px rgba(232,90,43,0.55); }
    .kz-portrait { position:relative; border-radius:var(--radius-xl); overflow:hidden; border:1px solid rgba(255,240,225,0.12); box-shadow:var(--shadow-lg), 0 0 70px -18px rgba(232,90,43,0.30); transition:transform 0.3s var(--ease-out); will-change:transform; }
    .kz-portrait img { width:100%; display:block; aspect-ratio:4/5; object-fit:cover; }
    .kz-portrait__badge { position:absolute; bottom:14px; left:14px; background:rgba(14,12,10,0.78); backdrop-filter:blur(8px); color:var(--ink); font-size:13px; font-weight:600; padding:8px 14px; border-radius:999px; border:1px solid rgba(255,240,225,0.14); }
    .kz-traits { list-style:none; display:flex; flex-direction:column; gap:14px; margin-top:8px; }
    .kz-traits li { padding-left:26px; position:relative; color:var(--slate); font-size:1.05rem; }
    .kz-traits li::before { content:'→'; position:absolute; left:0; color:var(--indigo); font-weight:700; }
    .kz-traits strong { color:var(--ink); }
    .kz-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:48px; }
    .kz-step { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-lg); padding:30px; transition:transform 0.3s var(--ease-out), background 0.3s; will-change:transform; }
    .kz-step:hover { background:rgba(255,255,255,0.07); }
    .kz-step__k { font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:0.12em; color:#FFB088; margin-bottom:14px; }
    .kz-step h4 { font-size:1.3rem; font-weight:700; margin-bottom:8px; color:#fff; }
    .kz-step p { color:rgba(255,255,255,0.65); font-size:0.97rem; }
    @media (max-width:760px){
      #wer-ich-bin .kz-wrap > div, .kz-duo-grid { grid-template-columns:1fr !important; }
      .kz-offer, .kz-fit-grid, .kz-process, .kz-decision-grid, .kz-steps { grid-template-columns:1fr !important; }
      .kz-process__step { min-height:auto; }
      .kz-hero__grid { display:none; }
    }

    /* --- Neue Sektionen der Meisterseiten-Startseite (Design: Fable 5, 2026-07-28) --- */
    .kz-hero__note { margin-top:18px; font-size:0.85rem; color:var(--slate-2); letter-spacing:0.01em; line-height:1.6; }


    /* Beispiel-Sektion: warme Bühne — die Glut kommt von unten, wo die
       Screenshots als beleuchtetes Objekt stehen. */
    .kz-demo-section {
      background:
        radial-gradient(90% 80% at 50% 110%, rgba(232,90,43,0.14), transparent 65%),
        var(--paper-2);
      border-top:1px solid var(--line-soft); border-bottom:1px solid var(--line-soft);
    }

    .kz-demo-cta { display:flex; align-items:center; flex-wrap:wrap; gap:18px; margin-top:clamp(24px,4vw,36px); }
    .kz-demo-hint { font-size:0.85rem; color:var(--slate-2); line-height:1.5; max-width:38ch; }

    .kz-faq { margin-top:clamp(28px,4vw,44px); border-top:1px solid var(--line); }
    .kz-faq__item { border-bottom:1px solid var(--line); }
    .kz-faq__item summary { position:relative; list-style:none; cursor:pointer; padding:18px 48px 18px 0; font-weight:700; font-size:1.02rem; letter-spacing:-0.01em; color:var(--ink); }
    .kz-faq__item summary::-webkit-details-marker { display:none; }
    .kz-faq__item summary::after { content:"+"; position:absolute; right:2px; top:50%; translate:0 -50%; width:26px; height:26px; display:grid; place-items:center; border:1px solid var(--line); border-radius:50%; background:var(--card); font-family:var(--font-mono); font-size:15px; font-weight:700; color:var(--indigo-deep); transition:transform 0.35s var(--ease-out); }
    .kz-faq__item[open] summary::after { transform:rotate(45deg); }
    .kz-faq__item summary:hover { color:var(--indigo-deep); }
    .kz-faq__item summary:focus-visible { outline:2px solid var(--indigo); outline-offset:3px; border-radius:6px; }
    .kz-faq__item p { color:var(--slate); font-size:0.98rem; line-height:1.65; max-width:62ch; padding:0 48px 20px 0; }

    .kz-person-grid { display:grid; grid-template-columns:minmax(0,0.9fr) 1.1fr; gap:clamp(28px,6vw,72px); align-items:center; }

    @media (max-width: 760px) {
      .kz-person-grid { grid-template-columns:1fr; gap:28px; }
      .kz-demo-cta { flex-direction:column; align-items:flex-start; gap:12px; }
      .kz-demo-hint { max-width:none; }
      .kz-hero__note { font-size:0.82rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .kz-faq__item summary::after { transition:none; }
    }

    /* ===== Beispiel-Sektion: Screenshot-Bühne (Design: Fable, 28.07.) ===== */
    .kz-demo-stage { position:relative; display:block; margin-top:clamp(32px,5vw,56px); text-decoration:none; }
    .kz-demo-stage:focus-visible { outline:2px solid var(--indigo); outline-offset:6px; border-radius:var(--radius-lg); }

    /* Die hellen Screenshots sind auf Charcoal das hellste Element der
       Seite — deshalb bekommen sie eine kräftige FASSUNG: dunkle
       Browser-Leiste, deutliche Lichtkante, Glut-Schein dahinter.
       So lesen sie sich als gezeigtes Objekt, nicht als Loch im Layout. */
    .kz-demo-browser { display:block; width:calc(100% - clamp(56px,9vw,120px)); margin-bottom:clamp(28px,5vw,64px); background:var(--coal); border:1px solid rgba(255,240,225,0.16); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-lg), 0 0 90px -18px rgba(232,90,43,0.40); }
    .kz-demo-browser img { display:block; width:100%; height:auto; }
    .kz-demo-browser__bar { display:flex; align-items:center; gap:14px; padding:10px 14px; background:var(--coal); border-bottom:1px solid rgba(255,240,225,0.10); }
    .kz-demo-browser__dots { display:flex; gap:6px; }
    .kz-demo-browser__dots i { width:9px; height:9px; border-radius:50%; background:rgba(255,240,225,0.22); }
    .kz-demo-browser__dots i:first-child { background:var(--violet); }
    .kz-demo-browser__url { flex:1; text-align:center; font-size:0.8rem; color:var(--slate); background:rgba(255,240,225,0.06); border:1px solid rgba(255,240,225,0.10); border-radius:999px; padding:4px 14px; max-width:32ch; margin-inline:auto; letter-spacing:0.01em; }

    .kz-demo-phone { position:absolute; right:0; bottom:0; display:block; width:clamp(132px,17vw,218px); padding:5px; background:#0A0806; border:1px solid rgba(255,240,225,0.16); border-radius:22px; box-shadow:var(--shadow-lg), 0 0 50px -10px rgba(232,90,43,0.35); }
    .kz-demo-phone img { display:block; width:100%; height:auto; border-radius:17px; }

    /* Der EINE inszenierte Moment der Seite: die Bühne gleitet ein, dann setzt sich
       das Handy mit kurzem Nachlauf auf den Screenshot. Nicht auf andere Sektionen
       kopieren — craft-floor: eine authored moment, keine verstreuten Effekte. */
    @media (prefers-reduced-motion: no-preference) {
      .kz-demo-phone { opacity:0.2; transform:translateY(34px) rotate(3deg); transition:opacity 0.9s var(--ease-out) 0.35s, transform 0.9s var(--ease-out) 0.35s; }
      .kz-demo-stage.is-in .kz-demo-phone { opacity:1; transform:none; }
      .kz-demo-browser { transition:transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out); }
      .kz-demo-stage:hover .kz-demo-browser, .kz-demo-stage:focus-visible .kz-demo-browser { transform:translateY(-4px); box-shadow:var(--shadow-lg); }
    }

    /* ===== Leistungen: ein Kernversprechen, fünf Fakten ===== */
    .kz-leist { margin-top:clamp(28px,4vw,44px); }

    .kz-leist__hero { position:relative; overflow:hidden; display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr); gap:clamp(24px,4vw,48px); align-items:center; background:var(--coal); border:1px solid rgba(255,143,94,0.18); border-radius:var(--radius-xl); padding:clamp(28px,4.5vw,52px); box-shadow:var(--shadow-lg); }
    .kz-leist__hero::before { content:""; position:absolute; right:-18%; bottom:-55%; width:70%; aspect-ratio:1; background:radial-gradient(circle, var(--glow), transparent 65%); pointer-events:none; }
    .kz-leist__hero h3 { color:var(--ink); font-size:clamp(1.45rem,2.6vw,2rem); line-height:1.15; letter-spacing:-0.02em; font-weight:800; }
    .kz-leist__hero p { margin-top:12px; color:color-mix(in srgb, var(--slate) 84%, var(--violet) 16%); font-size:clamp(1rem,1.5vw,1.1rem); line-height:1.65; max-width:46ch; }

    .kz-leist__note { position:relative; display:grid; justify-items:end; }
    .kz-leist__note-card { display:flex; align-items:flex-start; gap:12px; width:min(340px,100%); background:var(--card); border-radius:var(--radius-lg); padding:14px 16px; box-shadow:var(--shadow-md); }
    .kz-leist__note-lines { display:grid; gap:7px; flex:1; min-width:0; }
    .kz-leist__note-lines b { font-size:0.92rem; color:var(--ink); letter-spacing:-0.01em; line-height:1.35; }
    .kz-leist__note-bar { display:block; height:8px; border-radius:4px; background:var(--paper-2); border:1px solid var(--line-soft); }
    .kz-leist__note-card em { font-style:normal; font-size:0.78rem; color:var(--slate-2); flex:none; }

    .kz-leist__dot { display:inline-block; width:9px; height:9px; border-radius:50%; background:var(--indigo); flex:none; }
    .kz-leist__note-card .kz-leist__dot { margin-top:4px; }

    .kz-leist__list { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; column-gap:clamp(28px,5vw,64px); margin-top:clamp(8px,1.5vw,16px); }
    .kz-leist__list li { padding-block:clamp(18px,2.5vw,26px); border-top:1px solid var(--line-soft); }
    .kz-leist__list li:nth-child(-n+2) { border-top:0; }
    .kz-leist__list h3 { font-size:1.08rem; font-weight:700; letter-spacing:-0.01em; color:var(--ink); line-height:1.3; }
    .kz-leist__list h3 .kz-leist__dot { margin-right:10px; translate:0 -1px; }
    .kz-leist__list p { margin-top:8px; color:var(--slate); font-size:0.95rem; line-height:1.62; max-width:52ch; }

    @media (max-width:760px) {
      .kz-demo-browser { width:calc(100% - clamp(44px,12vw,64px)); }
      .kz-demo-phone { width:clamp(104px,30vw,132px); border-radius:18px; }
      .kz-demo-phone img { border-radius:14px; }
      .kz-demo-browser__url { max-width:none; }

      .kz-leist__hero { grid-template-columns:1fr; padding:clamp(24px,6vw,32px); }
      .kz-leist__note { justify-items:start; }
      .kz-leist__list { grid-template-columns:1fr; }
      .kz-leist__list li:nth-child(2) { border-top:1px solid var(--line-soft); }
    }

    /* ═══════════════════════════════════════════════════════════════════
       DIE BÜHNE — visuelle Tiefe (Design: Fable, 2026-08-26)
       ───────────────────────────────────────────────────────────────────
       Ein fixierter Bildraum hinter der ganzen Seite (Markup + Logik von
       Opus, kz-buehne.js). Drei Schichten Tiefe:
         1. die Motive (zuunterst, ziehen langsamer als der Inhalt),
         2. der Schleier (hält jede Textzeile über jedem Motiv lesbar),
         3. der Inhalt — Platten und Karten mit echtem Schattenwurf.

       Lesbarkeit ist GERECHNET, nicht geschätzt — aber der Schutz liegt
       seit 26.08. nicht mehr komplett im fixen Schleier (der machte den
       Hero-Film unsichtbar, Bens Befund). Die Arbeit ist verteilt:
         · fixer Schleier: nur noch Grundtönung (α .30) + Bodenanker —
           im Hero bleibt der Film dadurch sichtbar.
         · Hero-Bühne: trägt ihren eigenen Textschutz — links dicht
           (α .80 lokal, ⊕ Grundton ≈ .86 gesamt), rechts offen, wo Mann
           und Rolltor sich bewegen.
         · transparente Sektionen: tragen ihr Spalten-Plateau selbst
           (α .795 lokal ⊕ Grundton = .857 — exakt die alte Deckung).
           Es scrollt mit dem Text: unter jeder Zeile identisch dicht.
       Zielwerte über der Inhaltsbreite (gemessen per Playwright-Sampling,
       hellster Pixel unter jeder Textbox über die ganze Film-Strecke):
         --slate  (Fließtext)      ≥ 6.0:1
         --slate-2 (Tertiärtext)   ≥ 4.7:1  (Token dafür unten angehoben)
         --ink    (Überschriften)  ≥ 11:1
       ══════════════════════════════════════════════════════════════════ */

    .kz-buehne {
      position: fixed; inset: 0;
      z-index: -1;                /* hinter allem Inhalt, vor dem Canvas */
      overflow: hidden;
      background: var(--paper);   /* Boden unter den Motiven */
      pointer-events: none;
    }

    /* Eine Lage = ein Motiv. Der Hero liegt zuunterst und ist immer da —
       die anderen decken ihn beim Einblenden zu. So braucht der Wechsel
       keinen Schwarz-Zwischenschritt: es blendet immer Bild ÜBER Bild. */
    .kz-buehne__lage {
      position: absolute; inset: 0;
      opacity: 0;
      /* Bühne zieht langsamer als der Inhalt: über die ganze Seite wandern
         die Motive 3.2vh nach oben — gerade genug, dass der Raum sich
         bewegt, ohne dass es nach Effekt aussieht. Die leichte Skalierung
         hält dabei die Ränder (und den Unschärfe-Saum) aus dem Bild. */
      transform: translate3d(0, calc(var(--kz-buehne-p, 0) * -3.2vh), 0) scale(1.07);
      transition: opacity 1.5s var(--ease-soft);
      will-change: opacity, transform;
    }
    .kz-buehne__lage.ist-da { opacity: 1; transition-duration: 1s; }
    .kz-buehne__lage[data-lage="hero"] { opacity: 1; }

    .kz-buehne__bild,
    .kz-buehne__film {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
    }

    /* Tiefenstaffelung: die Standbilder stehen eine Spur hinter der
       Schärfeebene — leicht unscharf, entsättigt, gedimmt. Der Hero
       bleibt scharf: er ist der Auftritt, nicht die Kulisse. */
    .kz-buehne__lage:not([data-lage="hero"]) .kz-buehne__bild {
      filter: blur(2px) saturate(0.88) brightness(0.9);
    }

    /* Das Video liegt über seinem Poster und blendet erst ein, wenn es
       wirklich läuft (kz-buehne.js setzt .film-an) — kein schwarzer Frame,
       kein Sprung. Rückweg ohne Transition: Poster sofort da. */
    .kz-buehne__film { opacity: 0; }
    .film-an .kz-buehne__film { opacity: 1; transition: opacity 0.9s var(--ease-soft); }

    /* DER SCHLEIER — seit 26.08. nur noch die Grundtönung.
       α .30 hält die Motive als Raum (nie Poster) und lässt den Hero-Film
       durchscheinen; dazu ein leichter Bodenanker am Viewport-Grund.
       Das dichte Spalten-Plateau, das hier früher lag, wanderte in die
       Elemente, die es wirklich brauchen: die Hero-Bühne (Textschutz
       links) und die transparenten Sektionen (Scrim scrollt mit). */
    .kz-buehne__schleier {
      position: absolute; inset: 0;
      background:
        linear-gradient(to top,
          rgb(20 18 16 / 0.34) 0%,
          rgb(20 18 16 / 0.10) 24%,
          rgb(20 18 16 / 0) 40%);
      background-color: rgb(20 18 16 / 0.30);
    }

    /* Der Hero-Film bekommt Licht: eine Spur heller und knackiger, damit
       Mann und Rolltor hinter dem Grundton α .30 klar zu erkennen sind.
       Gilt für Poster UND Video — kein Helligkeitssprung beim Einblenden. */
    .kz-buehne__lage[data-lage="hero"] .kz-buehne__bild,
    .kz-buehne__lage[data-lage="hero"] .kz-buehne__film {
      filter: brightness(1.12) contrast(1.03);
    }

    /* WANDERNDE SCRIMS — transparente Sektionen tragen ihr Plateau selbst.
       Lokal α .795 ⊕ Grundton .30 = .857 Gesamtdeckung über der
       Inhaltsbreite (exakt der alte, gerechnete Wert); an den Rändern
       .41 ⊕ .30 = .59 — das Motiv atmet dort weiter auf. Weil der Scrim
       am Element hängt, liegt er unter JEDER Textzeile gleich dicht,
       egal wo sie gerade im Viewport steht — auch über dem hellen
       Schlussbild des Films direkt nach der Hero-Strecke. */
    .kz-section:not(.kz-demo-section):not(.kz-fit-section):not([style*="background"]) {
      background:
        linear-gradient(to right,
          rgb(20 18 16 / 0.41) 0,
          rgb(20 18 16 / 0.795) max(16px, calc((100% - 1200px) / 2)),
          rgb(20 18 16 / 0.795) calc(100% - max(16px, calc((100% - 1200px) / 2))),
          rgb(20 18 16 / 0.41) 100%);
    }
    /* Die erste Sektion nach der Strecke schiebt sich über das helle
       Schlussbild des Films — die einzige Stelle, an der eine Scrim-Kante
       auf offene Bühne trifft. Sie bekommt dieselbe Materialität wie die
       Platten: Lichtkante oben, weicher Schattenwurf (Versatz + Unschärfe)
       nach oben auf das Tor dahinter. So liest sich die Kante als Panel,
       nicht als Render-Fehler. */
    #main > .kz-section:first-child {
      box-shadow:
        inset 0 1px 0 rgba(255, 240, 225, 0.06),
        0 -30px 56px -30px rgb(0 0 0 / 0.6);
    }

    /* Tertiärtext eine Stufe heller: #A08D7C hielt auf dem Schleier über
       einem hellen Bildfleck nur ~3.8:1. #B2A08F hält dort 4.7:1 und auf
       plain Charcoal 7.4:1 — bleibt klar unter --slate in der Hierarchie.
       (:root:root schlägt das :root aus kz-v2.css unabhängig von der
       Ladereihenfolge. Der helle Anfrage-Bogen definiert sein --slate-2
       lokal und bleibt unberührt.) */
    :global(:root:root) { --slate-2: #B2A08F; }

    /* Die Navigation schwebt über dem Video — ihr Träger wird dichter
       (0.72 → 0.86), damit die Links auch über hellen Rolltor-Lamellen
       ≥ 6:1 halten. Der Blur bleibt. */
    .kz-nav.kz-nav { background: rgb(20 18 16 / 0.86); }

    /* DIE HERO-STRECKE — der Film bekommt Weg (Gerüst: Opus, 26.08.).
       Der Header ist 2,8 Bildschirmhöhen hoch; die sichtbare Bühne pinnt
       sich darin fest. Das Scrollrad ist der Abspielkopf des Films
       (kz-buehne.js) — mit einer Bildschirmhöhe war der Fünf-Sekünder
       nach einem Rad-Ruck durch.
       overflow:visible ist Pflicht: ein overflow:hidden am Header würde
       das Pinning brechen (sticky klemmt dann im Header fest statt am
       Viewport). Geclippt wird stattdessen in der Bühne selbst.
       (Doppelklasse: gewinnt gegen kz-v2.css / kz-v2-polish.css.) */
    .kz-hero.kz-hero--strecke {
      height: 280svh;
      min-height: 0;
      display: block;
      padding-top: 0;
      overflow: visible;
      background: none;
    }
    /* Die Aurora zieht mit auf die gepinnte Bühne (unten) — auf dem
       2,8-Schirme-Header stünde sie an der falschen Stelle. */
    .kz-hero.kz-hero--strecke::before { content: none; }

    /* Die gepinnte Bühne übernimmt Layout UND Licht des alten Heros:
       Flex-Zentrierung, Nav-Abstand, Glutherde. Dazu ihr eigener
       TEXTSCHUTZ — ein Keil Charcoal über der Textspalte links
       (α .80 lokal ⊕ Grundton .30 ≈ .86 gesamt, wie das alte Plateau),
       der ab der rechten Kante der Textspalte auf null ausläuft:
       rechts, wo Mann und Rolltor spielen, liegt nur noch der Grundton. */
    .kz-hero__buehne {
      position: sticky; top: 0;
      height: 100svh;
      display: flex; align-items: center;
      padding-top: 96px;
      overflow: hidden;
      background:
        radial-gradient(90% 60% at 12% 108%, rgba(232, 90, 43, 0.20), transparent 60%),
        radial-gradient(70% 55% at 88% -10%, rgba(255, 122, 69, 0.10), transparent 55%),
        radial-gradient(50% 40% at 70% 90%, rgba(69, 191, 198, 0.05), transparent 70%),
        linear-gradient(to right,
          rgb(20 18 16 / 0.86) 0,
          rgb(20 18 16 / 0.86) calc(max(16px, (100% - 1200px) / 2) + 730px),
          rgb(20 18 16 / 0) calc(max(16px, (100% - 1200px) / 2) + 1030px));
    }
    /* Aurora, 1:1 aus kz-v2-polish.css hierher gezogen. */
    .kz-hero__buehne::before {
      content: '';
      position: absolute; inset: 0;
      z-index: 0; pointer-events: none;
      background:
        radial-gradient(38% 38% at 24% 78%, rgba(232, 90, 43, 0.16), transparent 70%),
        radial-gradient(34% 34% at 76% 26%, rgba(255, 122, 69, 0.11), transparent 70%);
      filter: blur(48px);
      animation: kz-aurora 22s ease-in-out infinite alternate;
    }

    @media (max-width: 760px) {
      /* Mobil füllt der Text fast den ganzen Schirm (Note endet gemessen
         bei ~93 % Höhe) — großflächig öffnen geht nicht. Stattdessen ein
         LICHTSPALT UNTERM TOR: die letzten ~44px bleiben offen. Dort
         fällt am Anfang Licht durch den offenen Torspalt und verschwindet,
         wenn die Unterkante den Boden erreicht — genau der Filmmoment.
         220svh statt 280: am Daumen fühlen sich 2,8 Schirme Pinning zäh
         an. Der Spalt ist von UNTEN verankert (px, nicht %), damit er auf
         höheren Phones nicht in den Text wandert. */
      .kz-hero.kz-hero--strecke { height: 220svh; }
      .kz-hero__buehne {
        background:
          radial-gradient(90% 60% at 12% 108%, rgba(232, 90, 43, 0.20), transparent 60%),
          radial-gradient(70% 55% at 88% -10%, rgba(255, 122, 69, 0.10), transparent 55%),
          linear-gradient(to bottom,
            rgb(20 18 16 / 0.86) 0,
            rgb(20 18 16 / 0.86) calc(100% - 44px),
            rgb(20 18 16 / 0.24) calc(100% - 4px));
      }
    }

    /* Höhen-Leitplanke: auf sehr flachen Schirmen ist der Hero-Inhalt
       höher als eine Bildschirmhöhe. Der alte Hero wuchs einfach mit
       (min-height) — die gepinnte 100svh-Bühne würde ihn CLIPPEN.
       Deshalb dort: kein Pinning, Bühne wächst wieder, Lichtspalt zu
       (er läge sonst im Text). Der Film scrubbt dann kurz — Lesbarkeit
       schlägt Inszenierung. */
    @media (max-height: 720px) {
      .kz-hero.kz-hero--strecke { height: auto; min-height: 100svh; }
      .kz-hero__buehne {
        position: relative; height: auto; min-height: 100svh;
      }
    }
    @media (max-height: 720px) and (max-width: 760px) {
      .kz-hero__buehne {
        background:
          radial-gradient(90% 60% at 12% 108%, rgba(232, 90, 43, 0.20), transparent 60%),
          radial-gradient(70% 55% at 88% -10%, rgba(255, 122, 69, 0.10), transparent 55%),
          linear-gradient(rgb(20 18 16 / 0.86), rgb(20 18 16 / 0.86));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      /* Ohne Bewegung gibt es nichts zu scrubben: Strecke zurück auf eine
         Bildschirmhöhe, kein Pinning — der Hero ist wieder ein normaler,
         voller Schirm mit Poster. */
      .kz-hero.kz-hero--strecke { height: auto; min-height: 100svh; }
      .kz-hero__buehne { position: relative; height: auto; min-height: 100svh; }
    }

    /* MATERIALITÄT — Abschnitte mit eigenem Grund liegen als Platten VOR
       der Bühne: Lichtkante oben (Licht fällt von oben), weicher
       Schattenwurf mit Versatz UND Unschärfe nach unten auf den Bildraum
       dahinter. Das ist der Unterschied zwischen „Farbwechsel" und
       „liegt darüber". */
    .kz-section.kz-section[style*="paper-2"] { border-block: 1px solid var(--line-soft); }
    .kz-section.kz-section[style*="paper-2"],
    .kz-fit-section.kz-fit-section,
    .kz-demo-section.kz-demo-section,
    :global(.kz-anfrage.kz-anfrage) {
      box-shadow:
        inset 0 1px 0 rgba(255, 240, 225, 0.06),
        0 34px 64px -36px rgb(0 0 0 / 0.62);
    }

    /* Karten, die direkt auf dem Bildraum stehen (Angebot liegt in einer
       Fenster-Sektion), heben sich eine Stufe stärker ab als auf einer
       Platte: tieferer Wurf, gleiche Lichtkante. */
    .kz-offer__main, .kz-offer__side { box-shadow: var(--shadow-lg); }
    .kz-laufend { box-shadow: var(--shadow-md); }

    /* Reduzierte Bewegung: kein Video (kz-buehne.js lädt es gar nicht
       erst), kein Parallax-Zug, harte statt gleitender Lagenwechsel.
       Die leichte Skalierung bleibt — sie deckt den Unschärfe-Saum. */
    @media (prefers-reduced-motion: reduce) {
      .kz-buehne__lage { transition: none; transform: scale(1.03); }
      .kz-buehne__film { display: none; }
    }

  </style>

</body>
</html>
