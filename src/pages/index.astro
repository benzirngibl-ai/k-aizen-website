---
// k-AIzen — Startseite. Verkauft die MEISTERSEITE (Website-Paket, 297 €/Mo).
//
// POSITIONIERUNGSWECHSEL 2026-07-28 (Ben): Die Startseite verkaufte bis hierhin
// den KI-PA (1.899 €/Mo). Der PA wird in den Hintergrund geschoben und nur noch
// stückweise weiter integriert — die Startseite spricht ab jetzt AUSSCHLIESSLICH
// über das Website-Paket. Ben-Entscheid: KI-PA komplett von der Startseite runter
// (kein Abschnitt, keine Erwähnung). /ki-pa bleibt als Unterseite erreichbar.
// Vorgänger-Fassung liegt als index-ki-pa-backup.astro.bak daneben.
//
// Produktsubstanz stammt 1:1 aus der bestehenden /meisterseite (daf5058) und
// dem Angebots-Einseiter — bewusst KEINE neuen Versprechen erfunden.
const siteUrl = "https://k-aizen.de";
const homeUrl = `${siteUrl}/`;
const homeTitle = "k-AIzen — Website für Ihren Betrieb, komplett gebaut und betreut";
const homeDescription =
  "Ihre Website komplett gebaut, dauerhaft betreut, jede Anfrage sofort auf Ihrem Handy. 297 € im Monat, keine Einrichtungsgebühr, monatlich kündbar. Für Betriebe im Raum Nürnberg.";
const ogImage = `${siteUrl}/og-image.png`;
const benFoto = "/images/ben-portrait.png";

const PREIS = "297";
const demoUrl = "https://muster.k-aizen.de";
const calUrl = "https://cal.k-aizen.de/ben-kaizen/rueckruf";

const asyncMail = `mailto:kontakt@k-aizen.de?subject=${encodeURIComponent("Meisterseite — kurze Anfrage")}&body=${encodeURIComponent(`Hallo Ben,

ich habe einen Betrieb und interessiere mich für das Website-Paket.

1. Betrieb / Gewerk:
2. Aktuelle Website (falls vorhanden):
3. Was mich gerade am meisten stört:

Beste Grüße`)}`;

// Was im Paket steckt — Substanz identisch zur /meisterseite, damit beide Seiten
// dasselbe versprechen. Änderungen bitte an BEIDEN Stellen.
// Das Kernversprechen der Seite steht bewusst NICHT gleichrangig neben den anderen
// fünf Punkten — es bekommt eigenes Gewicht (Design: Fable, craft-floor: keine
// gleichförmigen Karten als Seitenstruktur, keine Nummern ohne Informationswert).
const leistungHero = {
  title: "Anfragen sofort auf Ihrem Handy",
  text: "Jemand füllt Ihr Formular aus — Sekunden später haben Sie Name, Nummer und Anliegen als Benachrichtigung. Kein Lead versauert im Postfach.",
};

const leistungen = [
  {
    title: "Website, komplett gebaut",
    text: "Modern, schnell, auf dem Handy perfekt. Sie liefern Logo, Fotos und Ihre Leistungen — den Rest machen wir.",
  },
  {
    title: "Online-Terminanfrage",
    text: "Ihre Kunden buchen einen Rückruf-Termin — auch abends um zehn, auch wenn Sie auf dem Gerüst stehen.",
  },
  {
    title: "Dauerhaft betreut",
    text: "Hosting, Pflege, Änderungen — alles drin. Neues Foto, andere Öffnungszeiten? Eine kurze Nachricht genügt, ist am selben Tag drin. Sie loggen sich nie ein.",
  },
  {
    title: "Datenschutz eingebaut",
    text: "Deutsche Server, kein US-Tracking, Impressum und Datenschutzerklärung sauber. Keine Abmahn-Angst.",
  },
  {
    title: "Gefunden werden",
    text: "Sauberer Suchmaschinen-Unterbau ab Werk — für Google und für KI-Antworten. Dieselbe Technik wie bei unseren eigenen Portalen.",
  },
];

const ablaufSchritte = [
  {
    k: "01",
    title: "Kurzes Gespräch",
    text: "15 Minuten: Wir klären, was Ihr Betrieb braucht und ob das Paket zu Ihnen passt. Ehrliche Antwort inklusive — auch wenn sie „noch nicht\" lautet.",
  },
  {
    k: "02",
    title: "Sie liefern das Material",
    text: "Einmalig Logo, ein paar Fotos und Ihre Leistungen. Mehr brauchen wir nicht von Ihnen.",
  },
  {
    k: "03",
    title: "Ihre Seite entsteht",
    text: "Wenige Tage später steht Ihre Website. Sie schauen in Ruhe drüber, wir passen an, bis es sitzt.",
  },
  {
    k: "04",
    title: "Läuft — dauerhaft",
    text: "Anfragen landen auf Ihrem Handy, Termine im Kalender. Änderungen jederzeit per Zuruf. Monatlich kündbar.",
  },
];

const fitCards = [
  {
    k: "Gut geeignet, wenn",
    title: "Ihr Betrieb läuft, aber online findet Sie kaum jemand.",
    items: [
      "Sie haben zufriedene Kunden und Bewertungen, aber keine oder eine veraltete Website.",
      "Anfragen kommen übers Telefon — und gehen unter, wenn Sie auf der Baustelle sind.",
      "Sie wollen sich um die Technik nicht kümmern müssen, sondern arbeiten.",
    ],
  },
  {
    k: "Eher nicht geeignet, wenn",
    title: "Sie eine Website zum Selbstbasteln oder einen reinen Baukasten suchen.",
    items: [
      "Sie wollen selbst einloggen, Seiten anlegen und alles eigenhändig pflegen.",
      "Der Betrieb ist ganz frisch und hat noch keine Kundenbasis, auf der eine Seite aufsetzen kann.",
      "Es soll einmal etwas gebaut und danach nie wieder angefasst werden.",
    ],
  },
];

const faqs = [
  {
    q: "Ist das wirklich monatlich kündbar?",
    a: "Ja. Keine Mindestlaufzeit, keine Einrichtungsgebühr. Wenn Sie kündigen, endet das Paket zum Monatsende — Ihr Risiko ist ein Monat.",
  },
  {
    q: "Wie schnell ist meine Website online?",
    a: "Sobald Logo, Fotos und Ihre Leistungen da sind, steht die Seite in der Regel innerhalb weniger Tage. Sie sehen sie vor dem Livegang.",
  },
  {
    q: "Was muss ich selbst machen?",
    a: "Einmalig Material liefern (Logo, ein paar Fotos, Ihre Leistungen) — das war es. Sie loggen sich nirgendwo ein und pflegen nichts. Änderungswünsche schicken Sie formlos per Nachricht.",
  },
  {
    q: "Wem gehört die Domain?",
    a: "Ihre Domain gehört Ihnen bzw. wird auf Ihren Betrieb registriert. Wenn Sie gehen, nehmen Sie sie mit.",
  },
  {
    q: "Warum monatlich statt einmalig?",
    a: "Weil eine Website kein Möbelstück ist, das man einmal hinstellt. Im Monatspreis stecken Hosting, Pflege, Änderungen und die laufende Technik — Sie zahlen für eine Seite, die dauerhaft funktioniert, nicht für eine Datei.",
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      "name": "k-AIzen",
      "url": homeUrl,
      "logo": `${siteUrl}/icons/kaizen-favicon.png`,
      "image": ogImage,
      "email": "kontakt@k-aizen.de",
      "founder": { "@id": `${siteUrl}/#benjamin-zirngibl` },
      "areaServed": ["Nürnberg", "Fürth", "Erlangen", "Schwabach", "DE"],
      "description":
        "k-AIzen baut und betreut Websites für kleine und mittlere Betriebe: komplett gebaut, dauerhaft gepflegt, jede Anfrage sofort auf dem Handy des Betriebs. 297 € im Monat, keine Einrichtungsgebühr.",
      "knowsAbout": [
        "Website erstellen lassen Nürnberg",
        "Website für kleine Unternehmen",
        "Website Handwerksbetrieb",
        "Homepage Autohaus Pflegedienst Fahrschule",
        "Website Betreuung monatlich",
        "Anfragen über die Website gewinnen",
        "DSGVO konforme Website",
      ],
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#benjamin-zirngibl`,
      "name": "Benjamin Zirngibl",
      "url": `${siteUrl}/about`,
      "image": `${siteUrl}${benFoto}`,
      "jobTitle": "Gründer",
      "worksFor": { "@id": `${siteUrl}/#organization` },
      "sameAs": ["https://www.linkedin.com/in/benjamin-zirngibl-0963753ab"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": homeUrl,
      "name": "k-AIzen",
      "inLanguage": "de-DE",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "about": { "@id": `${siteUrl}/#meisterseite-service` },
    },
    {
      "@type": "Service",
      "@id": `${siteUrl}/#meisterseite-service`,
      "name": "Meisterseite — Website-Paket für kleine und mittlere Betriebe",
      "serviceType": "Website-Erstellung und dauerhafte Betreuung",
      "provider": { "@id": `${siteUrl}/#organization` },
      "areaServed": ["Nürnberg", "Fürth", "Erlangen", "Schwabach"],
      "url": `${siteUrl}/meisterseite`,
      "description":
        "Website komplett gebaut und dauerhaft betreut: Lead-Formular mit Sofort-Benachrichtigung aufs Handy, Online-Terminanfrage, Hosting und Pflege inklusive, DSGVO-konform auf deutschen Servern.",
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Kleine und mittlere Betriebe: Handwerk, Handel, Dienstleistung, Gesundheit, Gastgewerbe",
      },
      "offers": {
        "@type": "Offer",
        "price": PREIS,
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": PREIS,
          "priceCurrency": "EUR",
          "unitText": "Monat",
        },
        "availability": "https://schema.org/InStock",
        "url": `${siteUrl}/meisterseite`,
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{homeTitle}</title>
  <meta name="description" content={homeDescription} />
  <link rel="canonical" href={homeUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content="Benjamin Zirngibl · k-AIzen" />
  <meta name="theme-color" content="#FCFCFD" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={homeTitle} />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:url" content={homeUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="k-AIzen" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={homeTitle} />
  <meta name="twitter:description" content={homeDescription} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="GPTBot" content="index, follow" />
  <meta name="ClaudeBot" content="index, follow" />
  <meta name="Claude-Web" content="index, follow" />
  <meta name="PerplexityBot" content="index, follow" />
  <meta name="Applebot" content="index, follow" />
  <link rel="icon" type="image/png" href="/icons/kaizen-favicon.png" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/icons/kaizen-favicon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs Full" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/v2/kz-v2.css?v=7" />
  <link rel="stylesheet" href="/v2/kz-v2-polish.css?v=7" />
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
</head>
<body>

  <!-- Scroll-Progress -->
  <div class="kz-progress"></div>

  <!-- NAV -->
  <nav class="kz-nav">
    <div class="kz-nav__brand">
      <img src="/animations/claude-design/logo-mark.png" alt="" class="kz-logo-mark" />
      <span class="kz-logo">k&#8209;<span class="kz-logo__ai">AI</span>zen</span>
    </div>
    <div class="kz-nav__links">
      <a href="#angebot">Das Paket</a>
      <a href="#ablauf">Ablauf</a>
      <a href="#beispiel">Beispiel</a>
      <a href="#fragen">Fragen</a>
    </div>
    <a href={calUrl} class="kz-btn kz-btn--primary" style="padding:11px 22px;font-size:14px;" target="_blank" rel="noopener">Rückruf</a>
  </nav>

  <!-- HERO -->
  <header class="kz-hero">
    <div class="kz-hero__grid"></div>
    <div class="kz-wrap">
      <div class="kz-hero__eyebrow kz-reveal"><span class="dot"></span> Für Betriebe im Raum Nürnberg</div>
      <h1 class="kz-h1 kz-kinetic">Ihre Website — komplett gebaut, dauerhaft betreut, <span class="accent">{PREIS} € im Monat.</span></h1>
      <p class="kz-hero__sub kz-reveal" data-delay="2">
        Sie liefern einmal Logo, Fotos und Ihre Leistungen. Wir bauen die Seite, halten sie am Laufen und kümmern uns um jede Änderung. Jede Anfrage landet Sekunden später als Benachrichtigung auf Ihrem Handy — auch wenn Sie gerade beim Kunden sind.
      </p>
      <div class="kz-hero__cta kz-reveal" data-delay="3">
        <a href={calUrl} class="kz-btn kz-btn--primary" target="_blank" rel="noopener">15 Minuten Rückruf vereinbaren <span class="kz-btn__arrow">→</span></a>
        <a href="#beispiel" class="kz-btn kz-btn--ghost">Beispiel-Website ansehen</a>
      </div>
      <p class="kz-hero__note kz-reveal" data-delay="4">
        Keine Einrichtungsgebühr · monatlich kündbar · Sie loggen sich nie ein
      </p>
    </div>
    <div class="kz-scrollcue" aria-hidden="true">
      <span class="kz-scrollcue__line"></span>
    </div>
  </header>

  <!-- 2 — DAS PROBLEM (Spiegel) -->
  <section class="kz-section">
    <div class="kz-wrap">
      <h2 class="kz-h2 kz-reveal" data-delay="1">
        „Die Arbeit läuft. Aber im Netz findet uns kaum jemand."
      </h2>
      <p class="kz-lead kz-reveal" data-delay="2">
        Viele gute Betriebe haben zufriedene Kunden, ordentliche Bewertungen — und keine Website. Oder eine, die vor acht Jahren gebaut wurde, auf dem Handy zerfällt und die niemand mehr anfassen kann. Der Grund ist selten Desinteresse. Der Grund ist, dass abends nach zwölf Stunden Baustelle niemand Lust auf Baukästen, Hosting-Rechnungen und Datenschutztexte hat.
      </p>
    </div>
  </section>

  <!-- 3 — REFRAME: Sie / wir -->
  <section class="kz-section" style="background:var(--paper-2);">
    <div class="kz-wrap">
      <h2 class="kz-h2 kz-reveal">Sie machen Ihre Arbeit. Wir machen die Website.</h2>
      <div class="kz-duo-grid">
        <div class="kz-reveal" data-delay="1">
          <div class="kz-split-card" data-tilt>
            <div class="kz-split-num">01</div>
            <h3 style="font-size:1.5rem;font-weight:700;margin-bottom:8px;">Ihr Betrieb</h3>
            <p style="color:var(--slate);">Sie können Ihr Geschäft. Sie liefern einmal Logo, ein paar Fotos und Ihre Leistungen — und arbeiten dann weiter wie bisher.</p>
          </div>
        </div>
        <div class="kz-reveal" data-delay="2">
          <div class="kz-split-card kz-split-card--accent" data-tilt>
            <div class="kz-split-num">02</div>
            <h3 style="font-size:1.5rem;font-weight:700;margin-bottom:8px;">k-AIzen</h3>
            <p style="color:rgba(255,255,255,0.85);">Wir bauen die Seite, hosten sie, pflegen sie und ändern, was geändert werden muss. Sie bekommen kein Login und keine Hausaufgaben.</p>
          </div>
        </div>
      </div>
      <p class="kz-lead kz-reveal" data-delay="3" style="margin-top:48px;text-align:center;margin-inline:auto;">
        Ein Preis, alles drin. Kein Baukasten, keine versteckten Extras, keine Rechnung für jede Kleinigkeit.
      </p>
    </div>
  </section>

  <!-- 3.5 — ZAHLEN-BAND -->
  <section class="kz-section" style="padding-block:0;">
    <div class="kz-wrap">
<!-- Bewusst OHNE data-count: der Count-up (kz-v2.js) würde einen Preis
           hochzählen lassen (wirkt wie ein Werbespot) und bei "0 €" 1,4 s lang
           von 0 auf 0 animieren — also sichtbar nichts tun. -->
      <div class="kz-stats kz-reveal">
        <div class="kz-stat">
          <div class="kz-stat__num">{PREIS} €</div>
          <div class="kz-stat__label">im Monat — Bau, Hosting, Pflege und Änderungen inklusive</div>
        </div>
        <div class="kz-stat">
          <div class="kz-stat__num">0 €</div>
          <div class="kz-stat__label">Einrichtungsgebühr, keine Mindestlaufzeit</div>
        </div>
        <div class="kz-stat">
          <div class="kz-stat__num">1</div>
          <div class="kz-stat__label">Nachricht genügt für jede Änderung — Sie loggen sich nie ein</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3.6 — ANGEBOT -->
  <section class="kz-section" id="angebot">
    <div class="kz-wrap">
      <h2 class="kz-h2 kz-reveal">Was Sie für {PREIS} € im Monat bekommen.</h2>
      <p class="kz-lead kz-reveal" data-delay="1">
        Keine Website, die nur schön dasteht. Eine Seite, die Anfragen annimmt und sie dorthin bringt, wo Sie sie sehen: auf Ihr Handy.
      </p>

      <div class="kz-leist">
        <article class="kz-leist__hero kz-reveal" data-delay="2">
          <div class="kz-leist__hero-copy">
            <h3>{leistungHero.title}</h3>
            <p>{leistungHero.text}</p>
          </div>
          <div class="kz-leist__note" aria-hidden="true">
            <span class="kz-leist__note-card">
              <i class="kz-leist__dot"></i>
              <span class="kz-leist__note-lines">
                <b>Neue Anfrage über Ihre Website</b>
                <i class="kz-leist__note-bar" style="width:72%"></i>
                <i class="kz-leist__note-bar" style="width:46%"></i>
              </span>
              <em>Jetzt</em>
            </span>
          </div>
        </article>

        <ul class="kz-leist__list">
          {leistungen.map((l, index) => (
            <li class="kz-reveal" data-delay={(index % 2) + 1}>
              <h3><i class="kz-leist__dot" aria-hidden="true"></i>{l.title}</h3>
              <p>{l.text}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="kz-offer kz-reveal" data-delay="3" style="margin-top:48px;">
        <div class="kz-offer__main">
          <div class="kz-offer__label">Der Preis</div>
          <h3>{PREIS} € im Monat — und das war's</h3>
          <p>
            Alles, was oben steht, steckt in diesem einen Preis. Es gibt keine Einrichtungsgebühr, keine Mindestlaufzeit und keine Position, die später dazukommt.
          </p>
          <ul class="kz-checklist">
            <li>Keine Einrichtungsgebühr — Sie starten mit dem ersten Monatsbeitrag.</li>
            <li>Monatlich kündbar. Ihr Risiko ist ein einziger Monat.</li>
            <li>Hosting, Pflege und Änderungen sind enthalten, nicht extra.</li>
            <li>Ihre Domain gehört Ihnen. Wenn Sie gehen, nehmen Sie sie mit.</li>
          </ul>
        </div>
        <aside class="kz-offer__side">
          <div class="kz-offer__side-k">Nächster Schritt</div>
          <h3>15 Minuten am Telefon</h3>
          <p>Wir schauen uns Ihren Betrieb an und sagen ehrlich, ob das Paket passt — auch wenn die Antwort „eher nicht" lautet.</p>
          <a href={calUrl} class="kz-btn kz-btn--primary" target="_blank" rel="noopener">Rückruf-Termin wählen <span class="kz-btn__arrow">→</span></a>
          <a href={asyncMail} class="kz-offer__link">Lieber kurz per Mail schreiben</a>
          <a href="/meisterseite" class="kz-offer__link">Alle Details zum Paket</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- 3.62 — BEISPIEL / DEMO — der visuelle Höhepunkt der Seite.
       Die Screenshots sind ECHTE Aufnahmen von muster.k-aizen.de (Playwright,
       28.07.2026), keine Mockups: Ben hat KI-Bilder ausdrücklich abgelehnt.
       Neu aufnehmen, wenn sich die Demo-Site ändert. -->
  <section class="kz-section kz-demo-section" id="beispiel">
    <div class="kz-wrap">
      <h2 class="kz-h2 kz-reveal">Schauen Sie sich an, was Sie bekommen.</h2>
      <p class="kz-lead kz-reveal" data-delay="1">
        Eine vollständige Beispiel-Website — die Dachdeckerei ist erfunden, die Technik ist echt. Dass das Beispiel aus dem Handwerk kommt, ist Zufall: Für ein Autohaus oder einen Pflegedienst sähe die Seite anders aus, funktionieren würde sie genauso. Probieren Sie ruhig das Kontaktformular aus: genau diese Anfrage landet Sekunden später als Benachrichtigung auf einem Handy. Bei Ihrer Website ist es dann Ihres.
      </p>

      <a
        href={demoUrl}
        class="kz-demo-stage kz-reveal"
        data-delay="2"
        target="_blank"
        rel="noopener"
        aria-label="Beispiel-Website Dachdeckerei Brandner und Sohn in neuem Tab öffnen"
      >
        <span class="kz-demo-browser">
          <span class="kz-demo-browser__bar" aria-hidden="true">
            <span class="kz-demo-browser__dots"><i></i><i></i><i></i></span>
            <span class="kz-demo-browser__url">muster.k-aizen.de</span>
          </span>
          <img
            src="/images/demo/muster-desktop.webp"
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            alt="Beispiel-Website der Demo-Dachdeckerei Brandner und Sohn: großes Titelbild „Ihr Dach in Meisterhand“, Bewertung 4,9 von 5 aus 87 Bewertungen und Knopf „Jetzt Anfrage senden“"
          />
        </span>
        <span class="kz-demo-phone">
          <img
            src="/images/demo/muster-mobil.webp"
            width="390"
            height="844"
            loading="lazy"
            decoding="async"
            alt="Dieselbe Beispiel-Website auf einem Handy-Bildschirm"
          />
        </span>
      </a>

      <div class="kz-demo-cta kz-reveal" data-delay="3">
