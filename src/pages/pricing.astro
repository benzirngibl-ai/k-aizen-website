---
import KaizenLayout from '../layouts/KaizenLayout.astro';

// Preise — seit 2026-07-28 auf EIN Produkt reduziert (Ben: Startseite verkauft die
// Meisterseite, der KI-PA rückt in den Hintergrund).
// Vorher stand hier der komplette KI-PA-Katalog inkl. Tier 1 / Tier 2 (Concierge) —
// Tier 2 war laut Preis-Doku seit 2026-07-12 ABGESCHAFFT und damit eine Karteileiche,
// die trotzdem noch öffentlich mit 12.999 € Setup ausgepreist war.
// Preisquelle: k-aizen/_shared/LINKS.md + memory/pricing_protection.
const PREIS = '297';

const enthalten = [
  'Website komplett gebaut — modern, schnell, auf dem Handy perfekt',
  'Lead-Formular: jede Anfrage sofort als Benachrichtigung auf Ihr Handy',
  'Anfragen-App: Stand setzen, Notizen führen, mit einem Tipp zurückrufen',
  'Hosting, Pflege und alle Änderungen — Sie loggen sich nie ein',
  'Impressum und Datenschutzerklärung sauber, deutsche Server, kein US-Tracking',
  'Suchmaschinen-Unterbau ab Werk — für Google und für KI-Antworten',
];

const nichtEnthalten = [
  {
    title: 'Einrichtungsgebühr',
    text: 'Es gibt keine. Sie starten mit dem ersten Monatsbeitrag, nicht mit einer vierstelligen Rechnung.',
  },
  {
    title: 'Mindestlaufzeit',
    text: 'Keine. Monatlich kündbar zum Monatsende — Ihr Risiko ist ein einziger Monat.',
  },
  {
    title: 'Kosten pro Änderung',
    text: 'Änderungen sind im Monatspreis enthalten. Es kommt keine Rechnung, weil ein Foto getauscht wurde.',
  },
];

const faqs = [
  {
    q: 'Warum monatlich und nicht einmalig?',
    a: 'Weil eine Website kein Möbelstück ist, das man einmal hinstellt. Im Monatspreis stecken Hosting, Pflege, Änderungen und die laufende Technik. Sie zahlen für eine Seite, die dauerhaft funktioniert — nicht für eine Datei, die nach zwei Jahren veraltet ist und die niemand mehr anfasst.',
  },
  {
    q: 'Ist das wirklich monatlich kündbar?',
    a: 'Ja. Keine Mindestlaufzeit, keine Einrichtungsgebühr. Wenn Sie kündigen, endet das Paket zum Monatsende.',
  },
  {
    q: 'Wem gehört die Domain?',
    a: 'Ihre Domain gehört Ihnen bzw. wird auf Ihren Betrieb registriert. Wenn Sie gehen, nehmen Sie sie mit.',
  },
  {
    q: 'Was kostet es, wenn ich später mehr will?',
    a: 'Das besprechen wir dann konkret. Es gibt Ausbaustufen — etwa eine KI, die Anrufe annimmt und Termine vereinbart. Nichts davon wird Ihnen beim Einstieg mitverkauft, und nichts läuft automatisch mit.',
  },
  {
    q: 'Gibt es Förderungen?',
    a: 'Für ein Website-Paket in dieser Größenordnung in der Regel nicht — der Aufwand für einen Förderantrag steht in keinem Verhältnis zu 297 € im Monat. Wir sagen Ihnen das lieber offen, als Ihnen Hoffnung zu machen.',
  },
];

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: 'Meisterseite — Website-Paket für kleine und mittlere Betriebe',
  description:
    'Website komplett gebaut und dauerhaft betreut: Lead-Formular mit Sofort-Benachrichtigung aufs Handy, Anfragen-App mit Bearbeitungsstand und Kunden-Notizen, Hosting und Pflege inklusive. Keine Einrichtungsgebühr, monatlich kündbar.',
  price: PREIS,
  priceCurrency: 'EUR',
  priceSpecification: {
    '@type': 'UnitPriceSpecification',
    price: PREIS,
    priceCurrency: 'EUR',
    unitText: 'Monat',
  },
  availability: 'https://schema.org/InStock',
  areaServed: ['Nürnberg', 'Fürth', 'Erlangen', 'Schwabach'],
  url: 'https://k-aizen.de/meisterseite',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<KaizenLayout
  title="Preise — 297 € im Monat, alles inklusive"
  description="Ein Produkt, ein Preis: Website komplett gebaut und dauerhaft betreut für 297 € im Monat. Keine Einrichtungsgebühr, keine Mindestlaufzeit, monatlich kündbar."
  path="/pricing"
  activeNav="pricing"
  jsonLd={[offerSchema, faqSchema]}
  breadcrumbs={[{ name: 'Preise', href: '/pricing' }]}
>
  <article class="kz-page">
    <div class="kz-page-eyebrow">
      <img src="/animations/claude-design/logo-mark.png" alt="" class="kz-mark" loading="lazy" />
      <img src="/icons/icon-ginkgo.png" alt="" class="kz-eyebrow-leaf" loading="lazy" />
      <span>Preise</span>
    </div>
    <h1 class="kz-h1">Ein Produkt. Ein Preis. Keine Überraschungen.</h1>
    <p class="kz-lead">
      Wir haben kein Preismodell mit Stufen, Paketen und Sternchen. Es gibt eine Website,
      komplett gebaut und dauerhaft betreut, und die kostet {PREIS} € im Monat.
    </p>

    <!-- Preis-Block -->
    <section class="kz-preis-block">
      <div class="kz-preis-zahl">
        <span class="kz-preis-betrag">{PREIS} €</span>
        <span class="kz-preis-einheit">pro Monat</span>
      </div>
      <div class="kz-preis-text">
        <h2 class="kz-h2" style="margin-top:0;">Die Meisterseite</h2>
        <p>
          Alles, was Ihre Website braucht, in einem Betrag: Bau, Hosting, Pflege,
          Änderungen und die Technik, die Anfragen auf Ihr Handy bringt.
        </p>
        <ul class="kz-checklist">
          {enthalten.map((e) => <li>{e}</li>)}
        </ul>
        <div class="kz-preis-cta">
          <a href="https://cal.k-aizen.de/ben-kaizen/rueckruf" class="kz-btn kz-btn--primary" target="_blank" rel="noopener">
            Rückruf-Termin wählen <span class="kz-btn__arrow">→</span>
          </a>
          <a href="/meisterseite" class="kz-btn kz-btn--ghost">Alle Details zum Paket</a>
        </div>
      </div>
    </section>

    <!-- Was NICHT dazukommt -->
    <section style="margin-top: 72px;">
      <h2 class="kz-h2">Was nicht dazukommt</h2>
      <p>
        Bei Website-Angeboten steckt der Ärger meistens im Kleingedruckten. Deshalb hier
        ausdrücklich, was es bei uns <em>nicht</em> gibt:
      </p>
      <div class="kz-nicht-grid">
        {nichtEnthalten.map((n) => (
          <article class="kz-nicht-card">
            <h3>{n.title}</h3>
            <p>{n.text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Rechenbeispiel -->
    <section style="margin-top: 72px;">
      <h2 class="kz-h2">Was das im Verhältnis bedeutet</h2>
      <p>
        {PREIS} € im Monat sind rund {Math.round(Number(PREIS) / 22)} € pro Arbeitstag. Ob sich
        das lohnt, hängt an einer einzigen Frage: Was ist bei Ihnen ein gewonnener Auftrag wert?
        Bei den meisten Betrieben, mit denen wir sprechen, reicht <strong>ein</strong> zusätzlicher
        Auftrag im Jahr, damit die Rechnung aufgeht. Wir versprechen Ihnen trotzdem keine
        Auftragszahlen — das kann seriös niemand.
      </p>
    </section>

    <!-- FAQ -->
    <section style="margin-top: 72px;">
      <h2 class="kz-h2">Häufige Fragen zum Preis</h2>
      <div class="kz-faq">
        {faqs.map((f) => (
          <details class="kz-faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Abschluss-CTA -->
    <section class="kz-preis-abschluss">
      <h2 class="kz-h2" style="margin-top: 0;">Der nächste Schritt kostet nichts</h2>
      <p>
        Fünfzehn Minuten am Telefon: Wir schauen uns Ihren Betrieb an und sagen ehrlich,
        ob das Paket passt. Wenn nicht, sagen wir das auch.
      </p>
      <div class="kz-preis-cta">
        <a href="https://cal.k-aizen.de/ben-kaizen/rueckruf" class="kz-btn kz-btn--primary" target="_blank" rel="noopener">
          Rückruf-Termin wählen <span class="kz-btn__arrow">→</span>
        </a>
        <a href="mailto:kontakt@k-aizen.de?subject=Meisterseite" class="kz-btn kz-btn--ghost">Oder kurz per Mail</a>
      </div>
    </section>
  </article>
</KaizenLayout>

<style>
  /* Preisseite — Gestaltung: Fable 5 (2026-07-28), Modell-Arbeitsteilung global */
  /* align-items:start — NICHT stretch: die Zahlenkarte würde sonst auf die volle
     Höhe der Textspalte (~700px) gezogen und die Zahl schwämme in leerer Fläche. */
  .kz-preis-block { display:grid; grid-template-columns:minmax(220px,0.85fr) 1.3fr; gap:clamp(24px,4vw,48px); align-items:start; margin:clamp(36px,6vw,64px) 0; padding:clamp(28px,5vw,52px); border-radius:var(--radius-xl); border:1px solid var(--line); background:var(--card); box-shadow:var(--shadow-lg); }
  .kz-preis-zahl { display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:10px; padding:clamp(28px,4vw,44px) clamp(20px,3vw,32px); border:1px solid var(--line); border-radius:var(--radius-lg); background:linear-gradient(170deg,var(--card) 30%,var(--indigo-wash)); box-shadow:var(--shadow-sm); }
  /* white-space:nowrap — sonst bricht "297 €" um und das € steht allein in Zeile 2. */
  .kz-preis-betrag { font-family:var(--font-sans); font-size:clamp(44px,6.5vw,76px); font-weight:800; line-height:1.05; letter-spacing:-0.03em; color:var(--ink); font-variant-numeric:tabular-nums; white-space:nowrap; }
  .kz-preis-einheit { font-family:var(--font-mono); font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; color:var(--indigo-deep); }
  .kz-preis-text > p { margin:10px 0 18px; color:var(--slate); line-height:1.65; max-width:52ch; }
  .kz-preis-cta { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-top:clamp(20px,3vw,28px); }

  .kz-nicht-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(14px,2vw,20px); margin-top:clamp(20px,3vw,28px); }
  .kz-nicht-card { padding:clamp(22px,3vw,30px); border-radius:var(--radius-lg); border:1px solid var(--line); background:var(--card); box-shadow:var(--shadow-sm); transition:transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out); }
  .kz-nicht-card:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); }
  .kz-nicht-card h3 { display:flex; align-items:baseline; gap:10px; margin:0 0 8px; font-size:16px; font-weight:700; letter-spacing:-0.01em; color:var(--ink); }
  .kz-nicht-card h3::before { content:"\2715"; flex:none; font-family:var(--font-mono); font-size:12px; font-weight:700; color:var(--teal); }
  .kz-nicht-card p { margin:0; font-size:14.5px; line-height:1.6; color:var(--slate); }

  .kz-faq { display:grid; gap:10px; max-width:760px; margin-top:clamp(20px,3vw,28px); }
  .kz-faq__item { border:1px solid var(--line); border-radius:var(--radius-md); background:var(--card); box-shadow:var(--shadow-sm); transition:border-color 0.25s var(--ease-out); }
  .kz-faq__item[open] { border-color:var(--indigo); }
  .kz-faq__item summary { list-style:none; position:relative; padding:16px 52px 16px 20px; font-weight:600; color:var(--ink); line-height:1.45; cursor:pointer; border-radius:var(--radius-md); }
  .kz-faq__item summary::-webkit-details-marker { display:none; }
  .kz-faq__item summary::marker { content:""; }
  .kz-faq__item summary::after { content:"+"; position:absolute; right:18px; top:50%; width:24px; height:24px; margin-top:-12px; display:grid; place-items:center; font-size:20px; font-weight:400; line-height:1; color:var(--indigo); transition:transform 0.3s var(--ease-out); }
  .kz-faq__item[open] summary::after { transform:rotate(45deg); }
  .kz-faq__item summary:focus-visible { outline:2px solid var(--indigo); outline-offset:2px; }
  .kz-faq__item summary:hover { color:var(--indigo-deep); }
  .kz-faq__item > p { margin:0; padding:0 52px 18px 20px; color:var(--slate); line-height:1.65; }

  .kz-preis-abschluss { margin-top:clamp(48px,7vw,80px); padding:clamp(32px,5vw,56px); text-align:center; border-radius:var(--radius-xl); border:1px solid var(--line-soft); background:linear-gradient(180deg,var(--paper-2),var(--card)); }
  .kz-preis-abschluss > p { max-width:56ch; margin:12px auto 0; color:var(--slate); line-height:1.65; }
  .kz-preis-abschluss .kz-preis-cta { justify-content:center; }

  @media (max-width:760px) {
    .kz-preis-block { grid-template-columns:1fr; gap:24px; padding:clamp(24px,6vw,32px); }
    .kz-preis-zahl { padding:26px 20px; }
    .kz-nicht-grid { grid-template-columns:1fr; }
    .kz-preis-cta { flex-direction:column; align-items:stretch; }
    .kz-preis-cta > * { width:100%; justify-content:center; text-align:center; }
    .kz-faq__item summary { padding-right:48px; }
    .kz-faq__item > p { padding-right:20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kz-nicht-card, .kz-faq__item, .kz-faq__item summary::after { transition:none; }
    .kz-nicht-card:hover { transform:none; }
  }
</style>
