---
import KaizenLayout from '../layouts/KaizenLayout.astro';
import AnfrageFormular from '../components/AnfrageFormular.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Kontakt — k-AIzen",
  "url": "https://k-aizen.de/kontakt",
  "mainEntity": {
    "@type": "Organization",
    "name": "k-AIzen",
    "email": "kontakt@k-aizen.de",
    "url": "https://k-aizen.de",
    "areaServed": "DE",
    "founder": { "@type": "Person", "name": "Benjamin Zirngibl" }
  }
};

const asyncMail = `mailto:kontakt@k-aizen.de?subject=${encodeURIComponent("Meisterseite — kurze Anfrage")}&body=${encodeURIComponent(`Hallo Ben,

ich habe einen Betrieb und interessiere mich für das Website-Paket.

1. Betrieb / Gewerk:
2. Aktuelle Website (falls vorhanden):
3. Was mich gerade am meisten stört:

Beste Grüße`)}`;
---

<KaizenLayout
  title="Kontakt — Termin oder direkte Nachricht"
  description="Kontakt zu k-AIzen: kostenloses Erstgespräch zum Website-Paket vereinbaren oder direkt an Benjamin Zirngibl schreiben."
  path="/kontakt"
  activeNav="kontakt"
  jsonLd={contactSchema}
>
  <style is:global>
    .kz-contact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin: 42px 0 72px;
    }
    .kz-contact-card {
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow-sm);
    }
    .kz-contact-card h3 {
      margin: 0 0 12px;
      font-size: 1.2rem;
    }
    @media (max-width: 820px) {
      .kz-contact-grid { grid-template-columns: 1fr; }
    }
  </style>

  <article class="kz-page kz-page--wide">
    {/* Eyebrow entfallen 2026-08-21 (craft-floor: kein Label über der Überschrift). */}
    <h1 class="kz-h1">Vier Wege zu mir. Such dir den bequemsten aus.</h1>
    <p class="kz-lead">
      Du musst dir vorher nichts überlegen und nichts vorbereiten. Es reicht,
      wenn du erzählst, wie Kunden dich heute finden — und was dabei untergeht.
    </p>

    <section class="kz-contact-grid">
      <article class="kz-contact-card">
        <h3>Erstgespräch</h3>
        <p>15 Minuten, kostenlos, ohne Verkaufsdruck. Du wählst den Termin, ich rufe zur vereinbarten Zeit an.</p>
        <p><a href="/erstgespraech" class="kz-btn">Termin wählen <span class="kz-btn__arrow">→</span></a></p>
      </article>
      <article class="kz-contact-card">
        <h3>Direkt schreiben</h3>
        <p>Kurze Mail reicht: Gewerk, aktuelle Website und was dich gerade stört. Ich antworte persönlich.</p>
        <p><a href={asyncMail} class="kz-btn kz-btn-ghost">Mail vorbereiten</a></p>
      </article>
      <article class="kz-contact-card">
        <h3>Mitlesen</h3>
        <p>Auf LinkedIn schreibe ich über Aufbau, Tests und echte Lernkurven rund um k-AIzen.</p>
        <p><a href="https://www.linkedin.com/in/benjamin-zirngibl-0963753ab" rel="noopener noreferrer" target="_blank" class="kz-btn kz-btn-ghost">LinkedIn ansehen</a></p>
      </article>
    </section>

    <section>
      <h2 class="kz-h2">Was für die erste Nachricht hilft</h2>
      <p>
        Wenn du das Formular unten nimmst, ist das schon abgedeckt — die Felder
        fragen genau danach.
      </p>
      <ul>
        <li><strong>Gewerk und Betriebsgröße</strong> — damit ich einordnen kann, worum es geht.</li>
        <li><strong>Deine aktuelle Website</strong> — Adresse, falls es eine gibt, oder der Hinweis, dass keine existiert.</li>
        <li><strong>Was dich stört</strong> — nicht gefunden werden, veraltete Seite, Anfragen gehen unter, niemand pflegt sie.</li>
        <li><strong>Wie Anfragen heute reinkommen</strong> — Telefon, Mail, Empfehlung, Google.</li>
      </ul>
    </section>

    <section style="margin-top: 96px; padding: 48px clamp(24px, 4vw, 48px); background: var(--kz-charcoal); color: var(--kz-cream); border-radius: 16px;">
      <h2 class="kz-h2" style="color: var(--kz-cream); margin-top: 0;">Postanschrift</h2>
      {/* Sekundärtext aus dem Warmton getönt (Token), nicht weiß gedimmt */}
      <p style="color: var(--ink-soft);">
        Benjamin Zirngibl — k-AIzen<br/>
        Zum Schwarzachtal 5 · 90592 Schwarzenbruck · Deutschland
      </p>
      <p style="color: var(--slate); font-size: 14px;">
        Die vollständigen rechtlichen Angaben stehen im <a href="/impressum" style="color: var(--kz-cream); text-decoration: underline;">Impressum</a>.
      </p>
    </section>
  </article>

  <AnfrageFormular quelle="k-aizen.de/kontakt" id="anfrage">
    <Fragment slot="intro">
      <h2 class="kz-h2">Schreib mir hier</h2>
      <p class="kz-lead">
        Der bequemste Weg: Felder ausfüllen, abschicken, fertig. Die Anfrage
        landet als Benachrichtigung auf meinem Handy — nicht in einem Postfach,
        das ich abends mal durchsehe.
      </p>
    </Fragment>
    <Fragment slot="button">Nachricht abschicken</Fragment>
    <Fragment slot="zusage">
      Antwort innerhalb eines Werktags. Kein Newsletter, kein Verkauf Ihrer Daten.
    </Fragment>
  </AnfrageFormular>
</KaizenLayout>
