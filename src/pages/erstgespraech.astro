---
import KaizenLayout from '../layouts/KaizenLayout.astro';

// Erstgespräch — seit 2026-07-28 auf das Website-Paket ausgerichtet (Ben: Startseite
// verkauft die Meisterseite, der KI-PA rückt in den Hintergrund).
// Vorher: 30-Minuten-KI-Potenzialgespräch mit Fit-Empfehlung KI-PA/KI-Check/Pilot.
// Jetzt: 15 Minuten Erstgespräch zum Website-Paket (deckungsgleich mit Startseite + /meisterseite).
//
// ⚠️ NIEMALS „Rückruf" als Rahmen der Seite (Ben, 21.08.2026: „ich will nur nicht random
//    angerufen werden, ich hasse telefonieren"). Ein Anruf ist NUR erlaubt, wenn der Besucher
//    vorher selbst einen Slot gewählt hat. Die drei Wege sind überall gleich:
//    Termin (Google) · WhatsApp · Mail — je mit vorgefertigtem Text.
//    Deckungsgleich mit der Kontakt-Sektion der Startseite.
const PREIS = '297';
const calUrl = 'https://calendar.app.google/AvBJwsvWrh4m26tV7';
const demoUrl = 'https://muster.k-aizen.de';

const waText = `Hallo Ben, ich habe einen Betrieb und interessiere mich für die Meisterseite.

Betrieb:
Ort:
Was ich mache: `;
const waLink = `https://wa.me/4915901031928?text=${encodeURIComponent(waText)}`;

const asyncMail = `mailto:kontakt@k-aizen.de?subject=${encodeURIComponent('Meisterseite — kurze Anfrage')}&body=${encodeURIComponent(`Hallo Ben,

ich habe einen Betrieb und interessiere mich für das Website-Paket.

1. Betrieb / Gewerk:
2. Aktuelle Website (falls vorhanden):
3. Was mich gerade am meisten stört:

Beste Grüße`)}`;

const outcomeCards = [
  {
    title: 'Passt es oder nicht',
    text: 'Du bekommst eine ehrliche Einschätzung, ob das Paket für deinen Betrieb Sinn ergibt — auch wenn die Antwort „eher nicht" lautet.',
  },
  {
    title: 'Was deine Seite können muss',
    text: 'Wir gehen durch, welche Leistungen draufgehören, welche Fragen deine Kunden immer stellen und wie Anfragen bei dir ankommen sollen.',
  },
  {
    title: 'Was als Nächstes passiert',
    text: 'Wenn es passt: welches Material du lieferst und wann deine Seite steht. Kein Angebot mit Fußnoten, keine Bedenkzeit unter Druck.',
  },
];

const noFitItems = [
  'Du möchtest selbst einloggen und deine Seiten eigenhändig pflegen — dafür gibt es günstigere Baukästen.',
  'Dein Betrieb ist ganz frisch und hat noch keine Kundenbasis, auf der eine Website aufsetzen kann.',
  'Du suchst eine einmalige Erstellung ohne laufende Betreuung.',
];

const conversationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://k-aizen.de/erstgespraech#webpage',
      url: 'https://k-aizen.de/erstgespraech',
      name: 'Erstgespräch vereinbaren — k-AIzen',
      description:
        'Kostenloses 15-Minuten-Erstgespräch zum Website-Paket: Wir klären, ob die Meisterseite zu deinem Betrieb passt, und sagen ehrlich ab, wenn nicht.',
      inLanguage: 'de-DE',
      isPartOf: { '@id': 'https://k-aizen.de/#website' },
      about: { '@id': 'https://k-aizen.de/#meisterseite-service' },
    },
    {
      '@type': 'Service',
      '@id': 'https://k-aizen.de/erstgespraech#service',
      name: 'Kostenloses Erstgespräch zum Website-Paket',
      serviceType: 'Beratungsgespräch Website für kleine und mittlere Betriebe',
      provider: {
        '@type': 'ProfessionalService',
        name: 'k-AIzen',
        url: 'https://k-aizen.de',
        email: 'kontakt@k-aizen.de',
      },
      areaServed: ['Nürnberg', 'Fürth', 'Erlangen', 'Schwabach'],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://k-aizen.de/erstgespraech#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Kostet das Gespräch etwas?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nein. Das Erstgespräch ist kostenlos und unverbindlich. Es dient dazu, zu klären, ob das Website-Paket zu deinem Betrieb passt.',
          },
        },
        {
          '@type': 'Question',
          name: 'Muss ich telefonieren?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nein. Du kannst genauso gut per WhatsApp oder Mail schreiben — der Text ist jeweils vorbereitet, du füllst drei Zeilen aus. Angerufen wird nur, wenn du selbst vorher einen Termin im Kalender gewählt hast.',
          },
        },
        {
          '@type': 'Question',
          name: 'Wie lange dauert das Gespräch?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Etwa 15 Minuten. Wir gehen deinen Betrieb durch, du siehst die Beispiel-Website, und du entscheidest danach in Ruhe.',
          },
        },
      ],
    },
  ],
};
---

<KaizenLayout
  title="Erstgespräch — 15 Minuten, unverbindlich"
  description="Kostenloses 15-Minuten-Erstgespräch zum Website-Paket. Wir klären, ob die Meisterseite zu deinem Betrieb passt — und sagen ehrlich ab, wenn nicht."
  path="/erstgespraech"
  activeNav="kontakt"
  jsonLd={conversationSchema}
  breadcrumbs={[{ name: 'Erstgespräch', href: '/erstgespraech' }]}
>
  <article class="kz-page">
    {/* Eyebrow beim Dark-Umbau entfallen (craft-floor: kein Label über
        der Überschrift). */}
    <h1 class="kz-h1">Fünfzehn Minuten. Dann weißt du, ob es passt.</h1>
    <p class="kz-lead">
      Du erzählst kurz von deinem Betrieb — am Telefon, per WhatsApp oder per Mail,
      das entscheidest du. Ich sage dir ehrlich, ob das Website-Paket für dich Sinn
      ergibt. Kein Verkaufsmarathon, keine Präsentation, kein Druck.
    </p>

    <!-- Vorbereitung -->
    <section class="kz-vorbereitung">
      <h2 class="kz-h2" style="margin-top: 0;">Vorher kurz reinschauen (2 Minuten)</h2>
      <p>
        Damit du nicht ohne Bild ins Gespräch gehst: Unter dem Link steht eine vollständige
        Beispiel-Website. Sie zeigt genau das, was du bekommen würdest — inklusive des
        Kontaktformulars, das du ruhig ausprobieren darfst.
      </p>
      <div class="kz-vorbereitung__cta">
        <a href={demoUrl} class="kz-btn" target="_blank" rel="noopener">Beispiel-Website ansehen →</a>
        <a href="/meisterseite" class="kz-btn kz-btn--ghost">Was im Paket steckt →</a>
      </div>
    </section>

    <section style="margin-top: 56px;">
      <h2 class="kz-h2">Was du danach weißt</h2>
      <p>
        Egal ob Telefonat oder Nachricht — am Ende soll klar sein, ob sich ein
        nächster Schritt lohnt. Für dich und für mich.
      </p>
      <div class="kz-outcome-grid">
        {outcomeCards.map((card) => (
          <article class="kz-outcome-card">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section style="margin-top: 56px;">
      <h2 class="kz-h2">So laufen die 15 Minuten am Telefon</h2>
      <p>
        Das gilt für den gebuchten Termin — angerufen wird nur, wenn du selbst vorher
        einen Slot gewählt hast. Schreibst du lieber, klären wir dieselben Punkte per
        WhatsApp oder Mail, in deinem Tempo.
      </p>
      <ul>
        <li><strong>Min 0–3</strong> — kurz gegenseitig vorstellen: dein Betrieb, was ich mache</li>
        <li><strong>Min 3–9</strong> — deine Situation: Wie kommen heute Anfragen rein, was geht dabei unter?</li>
        <li><strong>Min 9–13</strong> — was eine Website daran ändern würde und was nicht</li>
        <li><strong>Min 13–15</strong> — nächster Schritt oder ehrliche Absage</li>
      </ul>
    </section>

    <section>
      <h2 class="kz-h2">Was vorab hilft</h2>
      <p>Zwei Sätze reichen völlig — egal ob du buchst oder schreibst:</p>
      <ul>
        <li>Welches Gewerk und wie viele Leute im Betrieb</li>
        <li>Ob es schon eine Website gibt — und was dich daran stört</li>
      </ul>
      <p>Dann starten wir vorbereitet — und wenn du schreibst, bekommst du gleich eine konkrete Antwort statt einer Rückfrage.</p>
    </section>

    <section>
      <h2 class="kz-h2">Wann ich eher abrate</h2>
      <p>
        Ein Paket, das nicht passt, macht niemanden glücklich. Deshalb sage ich in
        diesen Fällen offen, dass es gerade nicht sinnvoll ist:
      </p>
      <ul>
        {noFitItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2 class="kz-h2">Was es kostet</h2>
      <p>
        Das Gespräch kostet nichts und verpflichtet zu nichts. Wenn du dich danach für
        das Paket entscheidest, kostet die Website {PREIS} € im Monat — ohne
        Einrichtungsgebühr, monatlich kündbar. Die vollständige Übersicht steht offen
        unter <a href="/pricing">Preise</a>.
      </p>
    </section>

    <section class="kz-wege">
      <h2 class="kz-h2" style="margin-top: 0;">Drei einfache Wege</h2>
      <p>
        Wenn du lieber sprichst: Termin wählen, dann rufe ich zur vereinbarten Zeit an.
        Wenn du lieber schreibst: WhatsApp oder Mail, Text steht schon da.
        Unangekündigt rufe ich nie an.
      </p>

      <div class="kz-wege-grid">
        <div class="kz-weg-card kz-weg-card--haupt">
          <div class="kz-weg-card__text">
            <h3>Termin im Kalender</h3>
            <p>Du wählst den Slot, ich rufe zur vereinbarten Zeit an. 15 Minuten, unverbindlich, danach entscheidest du in Ruhe.</p>
          </div>
          <a href={calUrl} class="kz-btn" target="_blank" rel="noopener">Termin wählen</a>
        </div>
        <div class="kz-weg-card">
          <h3>Kurz per WhatsApp</h3>
          <p>Der Text steht schon da — Betrieb, Ort, was du machst. Drei Zeilen ausfüllen, abschicken, fertig.</p>
          <a href={waLink} class="kz-btn kz-btn--ghost" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.916zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.148-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.29.173-1.414z"/></svg>
            WhatsApp schreiben
          </a>
        </div>
        <div class="kz-weg-card">
          <h3>Kurz per Mail</h3>
          <p>Gewerk, aktuelle Website, was dich stört. Du bekommst eine persönliche Einschätzung zurück.</p>
          <a href={asyncMail} class="kz-btn kz-btn--ghost">Mail schreiben</a>
        </div>
      </div>

      <p class="kz-wege-note">
        Lieber frei formulieren? <a href="mailto:kontakt@k-aizen.de">kontakt@k-aizen.de</a> — jede Anfrage wird persönlich beantwortet.
      </p>
    </section>
  </article>
</KaizenLayout>

<style>
  /* Erstgespräch-Seite — Gestaltung: Fable 5 (2026-07-28) */
  .kz-vorbereitung { margin-top:clamp(28px,4vw,40px); padding:clamp(24px,3.5vw,34px); border-radius:var(--radius-lg); border:1px solid var(--line); background:linear-gradient(150deg,var(--card) 55%,var(--indigo-wash)); box-shadow:var(--shadow-sm); }
  .kz-vorbereitung p { color:var(--slate); line-height:1.65; max-width:62ch; }
  .kz-vorbereitung__cta { display:flex; flex-wrap:wrap; gap:12px; margin-top:20px; }

  .kz-outcome-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr)); gap:16px; margin-top:24px; }
  .kz-outcome-card { padding:clamp(20px,3vw,26px); border-radius:var(--radius-md); border:1px solid var(--line-soft); background:var(--card); box-shadow:var(--shadow-sm); }
  .kz-outcome-card h3 { margin:0 0 8px; font-size:1.02rem; letter-spacing:-0.01em; color:var(--ink); }
  .kz-outcome-card p { margin:0; color:var(--slate); font-size:0.93rem; line-height:1.6; }

  .kz-wege { margin-top:80px; padding:clamp(32px,5vw,56px); border-radius:var(--radius-xl); border:1px solid var(--line-soft); background:linear-gradient(180deg,var(--paper-2),var(--card)); }
  .kz-wege > p { color:var(--slate); line-height:1.65; max-width:62ch; }
  /* 1 + 2: Der Termin ist der Hauptweg und liegt als volle Zeile oben,
     WhatsApp und Mail sind das schriftliche Paar darunter. */
  .kz-wege-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:24px; }
  .kz-weg-card--haupt { grid-column:1 / -1; display:flex; align-items:center; gap:clamp(20px,3.5vw,36px); }
  .kz-weg-card--haupt .kz-weg-card__text { flex:1 1 auto; min-width:0; }
  .kz-weg-card--haupt p { margin-bottom:0; }
  .kz-weg-card--haupt .kz-btn { flex-shrink:0; }
  .kz-weg-card { padding:clamp(20px,3vw,26px); border-radius:var(--radius-md); border:1px solid var(--line); background:var(--card); box-shadow:var(--shadow-sm); }
  .kz-weg-card h3 { margin:0 0 8px; font-size:1.05rem; letter-spacing:-0.01em; color:var(--ink); }
  .kz-weg-card p { margin:0 0 18px; color:var(--slate); font-size:0.93rem; line-height:1.6; }
  .kz-wege-note { margin-top:28px; font-size:0.88rem; color:var(--slate-2); }

  @media (max-width: 760px) {
    .kz-vorbereitung__cta .kz-btn { width:100%; justify-content:center; }
    .kz-wege-grid { grid-template-columns:1fr; }
    .kz-weg-card--haupt { flex-direction:column; align-items:stretch; }
    .kz-weg-card .kz-btn { width:100%; justify-content:center; }
  }
</style>
